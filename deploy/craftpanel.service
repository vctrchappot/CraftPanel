# systemd unit for CraftPanel on Linux (Raspberry Pi OS, Debian, Ubuntu, ...).
# Installed by deploy/install.sh (release) or deploy/install-linux.sh (git checkout); both replace it on update.
# Change settings in /etc/craftpanel/craftpanel.env instead: it overrides the defaults below and is kept.
[Unit]
Description=CraftPanel Minecraft server manager
After=network-online.target craftpanel-runtime.service
Wants=network-online.target craftpanel-runtime.service

[Service]
Type=simple
User=craftpanel
Group=craftpanel
WorkingDirectory=/opt/craftpanel
ExecStart=/usr/bin/node apps/api/dist/index.js
Environment=NODE_ENV=production
Environment=CRAFTPANEL_DATA_DIR=/var/lib/craftpanel
# Profile "lan": dashboard reachable from the local network; keep it off the public internet.
# Use "proxy" behind an HTTPS reverse proxy on this machine, or "local" for SSH-tunnel access.
Environment=CRAFTPANEL_PROFILE=lan
Environment=CRAFTPANEL_PORT=8080
EnvironmentFile=-/etc/craftpanel/craftpanel.env
# Only the dashboard stops here. The runtime owns Minecraft in a separate cgroup.
KillSignal=SIGTERM
TimeoutStopSec=120
# Never add PartOf= or BindsTo= between dashboard and runtime.
KillMode=mixed
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/craftpanel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
