# Process owner. Restarting craftpanel.service never stops this unit or its children.
[Unit]
Description=CraftPanel Minecraft runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=craftpanel
Group=craftpanel
WorkingDirectory=/opt/craftpanel
ExecStart=/usr/bin/node apps/api/dist/runtime.js
Environment=NODE_ENV=production
Environment=CRAFTPANEL_DATA_DIR=/var/lib/craftpanel
EnvironmentFile=-/etc/craftpanel/craftpanel.env
# Every server runs under its own craftpanel-game-NN account (see deploy/install.sh).
# Switch accounts via setpriv, which clears these before Java runs; give the game group
# access to server files; stop processes a server left behind.
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_KILL
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_KILL
KillSignal=SIGTERM
TimeoutStopSec=120
KillMode=mixed
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/craftpanel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
# Files are shared with the game account through its group, never with others.
UMask=0007

[Install]
WantedBy=multi-user.target
