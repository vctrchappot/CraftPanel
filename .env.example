# CraftPanel reads environment variables; it does not load .env automatically.
# For a checkout: node --env-file=.env apps/api/dist/index.js
# Installed service: /etc/craftpanel/craftpanel.env (Linux), config.env (Windows).

# Start profile (or pass --profile <name>, or run pnpm start:<name>):
#   local     dashboard on this computer only (default)
#   lan       dashboard reachable from other devices on your network
#   proxy     behind an HTTPS reverse proxy on this machine (Secure cookies, trusts X-Forwarded-For)
#   headless  API and WebSocket only, no web dashboard
# The variables below override individual parts of the profile.
CRAFTPANEL_PROFILE=local

# Interface and port the dashboard listens on (profile default: 127.0.0.1, or 0.0.0.0 for "lan").
# Which devices may actually connect is set in the dashboard: Settings → Remote access.
# CRAFTPANEL_HOST=127.0.0.1
CRAFTPANEL_PORT=8080

# Browser-facing origin, independent of the internal listener. No path prefixes.
# CRAFTPANEL_PUBLIC_URL=https://panel.example.com

# Only these proxy peers may supply client-IP and transport headers (comma-separated IPs/CIDRs).
# Setting this enables proxy support; the proxy profile defaults to 127.0.0.1,::1.
# A proxy on another host needs its exact private/VPN IP and a backend firewall rule.
# CRAFTPANEL_TRUSTED_PROXIES=127.0.0.1,::1

# Where servers, backups, Java runtimes and the database are stored.
# Defaults: Windows %LOCALAPPDATA%\CraftPanel, macOS ~/Library/Application Support/CraftPanel,
# Linux $XDG_DATA_HOME/craftpanel (~/.local/share/craftpanel).
# CRAFTPANEL_DATA_DIR=/srv/craftpanel

# Serve HTTPS directly with a PEM certificate and key (e.g. from `tailscale cert` or Let's Encrypt).
# Secure cookies are enabled automatically.
# CRAFTPANEL_TLS_CERT=/etc/craftpanel/cert.pem
# CRAFTPANEL_TLS_KEY=/etc/craftpanel/key.pem

# Secure cookies are mandatory for built-in TLS and an HTTPS public URL.
# CRAFTPANEL_SECURE_COOKIES=false
# Legacy switch: true trusts loopback proxy peers only. Prefer TRUSTED_PROXIES.
# CRAFTPANEL_TRUST_PROXY=false

# Session lifetime in hours (sliding).
CRAFTPANEL_SESSION_TTL_HOURS=168
# fatal | error | warn | info | debug  (debug also logs every HTTP request)
CRAFTPANEL_LOG_LEVEL=info
# pretty (readable, default) | json (for log collectors)
CRAFTPANEL_LOG_FORMAT=pretty
