# CraftPanel configuration (environment variables). Copy to .env and adjust, or
# set them in your service manager (systemd unit, Windows service, etc.).

# Interface the dashboard listens on. 127.0.0.1 = this machine only (default).
# Use a LAN address (e.g. 192.168.1.20) or 0.0.0.0 to manage CraftPanel from
# other devices on your network. Never port-forward the dashboard to the internet.
CRAFTPANEL_HOST=127.0.0.1
CRAFTPANEL_PORT=8080

# Where servers, backups, Java runtimes and the database are stored.
# Defaults: Windows %LOCALAPPDATA%\CraftPanel, macOS ~/Library/Application Support/CraftPanel,
# Linux $XDG_DATA_HOME/craftpanel (~/.local/share/craftpanel).
# CRAFTPANEL_DATA_DIR=/srv/craftpanel

# Set to true when CraftPanel is served over HTTPS (directly or via a reverse proxy).
CRAFTPANEL_SECURE_COOKIES=false
# Set to true when running behind a reverse proxy so client IPs are logged correctly.
CRAFTPANEL_TRUST_PROXY=false

# Session lifetime in hours (sliding).
CRAFTPANEL_SESSION_TTL_HOURS=168
# fatal | error | warn | info | debug
CRAFTPANEL_LOG_LEVEL=info
