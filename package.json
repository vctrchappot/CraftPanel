{
  "name": "craftpanel",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hosted Minecraft server manager",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @craftpanel/api dev",
    "dev:web": "pnpm --filter @craftpanel/web dev",
    "build": "pnpm --filter @craftpanel/web build && pnpm --filter @craftpanel/api build",
    "start": "node apps/api/dist/index.js",
    "start:local": "node apps/api/dist/index.js --profile local",
    "start:lan": "node apps/api/dist/index.js --profile lan",
    "start:proxy": "node apps/api/dist/index.js --profile proxy",
    "start:headless": "node apps/api/dist/index.js --profile headless",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @craftpanel/database generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
