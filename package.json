{
  "name": "craftpanel",
  "version": "0.2.1",
  "private": true,
  "description": "Self-hosted Minecraft server manager",
  "license": "FSL-1.1-ALv2",
  "author": "Victor (@vctrchappot) (https://www.vctr.site)",
  "homepage": "https://github.com/vctrchappot/CraftPanel",
  "repository": { "type": "git", "url": "https://github.com/vctrchappot/CraftPanel.git" },
  "bugs": "https://github.com/vctrchappot/CraftPanel/issues",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @craftpanel/api dev",
    "dev:web": "pnpm --filter @craftpanel/web dev",
    "build": "pnpm --filter @craftpanel/web build && pnpm --filter @craftpanel/api build",
    "start": "node apps/api/dist/index.js",
    "start:runtime": "node apps/api/dist/runtime.js",
    "start:local": "node apps/api/dist/index.js --profile local",
    "start:lan": "node apps/api/dist/index.js --profile lan",
    "start:proxy": "node apps/api/dist/index.js --profile proxy",
    "start:headless": "node apps/api/dist/index.js --profile headless",
    "craftpanel:update": "node scripts/update.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:deployment": "node scripts/real-tests/deployment.mjs",
    "doctor": "node apps/api/dist/index.js doctor",
    "db:generate": "pnpm --filter @craftpanel/database generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
