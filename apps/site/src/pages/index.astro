const softwareGroups: { label: string; wide: boolean; items: (keyof typeof software)[] }[] = [
  { label: "Plugin servers", wide: true, items: ["paper", "purpur"] },
  { label: "Mod loaders", wide: true, items: ["fabric", "neoforge"] },
  { label: "Unmodified", wide: false, items: ["vanilla"] },
  { label: "Proxy", wide: false, items: ["velocity"] },
];

const memoryOptions = [1, 2, 4, 8] as const;
const defaultSw = software.paper;
const defaultVer = defaultSw.versions[0];
const defaultMem = 2;
const defaultMeta = [`${defaultSw.name} ${defaultVer[0]}`, defaultVer[1], defaultSw.java].filter(Boolean).join(" · ");
const defaultMemText = `${(defaultMem * defaultSw.memRatio).toFixed(1)} / ${defaultMem.toFixed(1)}`;

const softwareTrust: { icon: UiIconName; title: string; text: string }[] = [
  { icon: "seal", title: "Official source", text: "Every server comes straight from the project that makes it." },
  { icon: "hash", title: "Checksum checked", text: "The download is verified before anything starts." },
  { icon: "cup", title: "Right Java, automatically", text: "CraftPanel installs the Java version your server needs." },
];

const minor: { title: string; icon: UiIconName; text: string; chips: string[] }[] = [
  { title: "Teams and permissions", icon: "users", text: "Roles per server, with two-factor sign-in and an audit log of who did what.", chips: ["owner", "admin", "operator", "viewer"] },
  { title: "Java, handled", icon: "cup", text: "Every Minecraft version gets the Java it needs, downloaded per server. Nothing to install.", chips: ["1.8.9 → 8", "1.21.4 → 21", "26.3 → 25"] },
  { title: "Scheduled tasks", icon: "clock", text: "Restarts with a 60-second warning in chat. Backups, announcements and commands too.", chips: ["0 4 * * *", "restart", "backup"] },
  { title: "Crash alerts", icon: "bell", text: "A message when a server crashes, a backup fails or a new release is out.", chips: ["Discord", "e-mail"] },
  { title: "Network tools", icon: "signal", text: "Addresses to copy and port checks, so your friends can actually join.", chips: ["LAN", "VPN", "CGNAT check", "DuckDNS"] },
  { title: "Files and worlds", icon: "folder", text: "Edit configs in the browser. Upload a world as a zip, or download one for single player.", chips: ["server.properties", "world.zip"] },
];

// Who the page speaks to; each card points at the part of the page that answers that group's first question.
const audiences: { title: string; question: string; text: string; link: { href: string; label: string } }[] = [
  {
    title: "Friends and family",
    question: "Can I do this without knowing Linux?",
    text: "The wizard picks the Java and memory, the network check tells you whether friends can join, and backups run on a schedule.",
    link: { href: "/docs/getting-started/first-server/", label: "Your first server" },
  },
  {
    title: "A Pi or a home server",
    question: "Does it run cleanly on my hardware?",
    text: "No Docker, no Java to install. Memory, CPU and process limits per server keep one server from starving the others.",
    link: { href: "#hardware", label: "Hardware estimates" },
  },
  {
    title: "Small communities",
    question: "Will it hold up with a team and several servers?",
    text: "Velocity in front of your servers, roles per server, two-factor sign-in, an audit log, scheduled restarts and crash alerts.",
    link: { href: "#features", label: "Features" },
  },
];

// Every claim here names where it holds; the security docs list the limits.
const safety: { icon: UiIconName; title: string; text: string }[] = [
  { icon: "lock", title: "Dashboard stays private", text: "Only private networks get in by default, and public clients are refused without HTTPS. Open only the Minecraft port." },
  { icon: "users", title: "Accounts, not a shared password", text: "Roles per server, two-factor sign-in, rate-limited logins and an audit log of who did what." },
  { icon: "seal", title: "Verified downloads", text: "Server software, Java, plugins and mods come from official hosts and are checked against their checksums." },
  { icon: "shield", title: "Each server on its own account", text: "On Linux service installs every Minecraft server runs under its own system account and can't read the others or the panel." },
  { icon: "chart", title: "Limits per server", text: "A memory cap, a CPU limit and a process limit, enforced by the system on Linux service installs and on Windows." },
  { icon: "terminal", title: "No shell, no telemetry", text: "The browser can only send Minecraft commands, never shell commands. Nothing phones home, not even a counter." },
];

const looks = [
  {
    key: "overview",
    label: "Overview",
    alt: "Server overview with players, CPU, memory, TPS, uptime, storage, the last console lines and connection addresses",
    spots: [
      { x: 95.8, y: 20.5, text: "Players, CPU, memory, TPS, uptime and disk, refreshed live." },
      { x: 66, y: 50, text: "The newest console lines, without opening the console." },
      { x: 89.5, y: 49.5, text: "Addresses to copy for this computer, your LAN and your VPN." },
      { x: 88.3, y: 9.6, text: "Start, stop, restart. Force-kill is for Administrators only." },
    ],
  },
  {
    key: "console",
    label: "Console",
    alt: "Live Minecraft console with a filter, level selector and command input",
    spots: [
      { x: 72.5, y: 21.7, text: "Filter by text or log level. Download or copy the log." },
      { x: 31, y: 27, text: "Live. After a dashboard restart it reconnects and replays what you missed." },
      { x: 88, y: 92, text: "Commands go to Minecraft only, never to a shell. ↑ and ↓ browse history." },
    ],
  },
  {
    key: "performance",
    label: "Performance",
    alt: "Performance tab with live charts for TPS, tick time, CPU, memory and players",
    spots: [
      { x: 66, y: 30.6, text: "TPS and tick time against the 50 ms budget. Lag shows where it happened." },
      { x: 52.5, y: 70.6, text: "CPU, memory against the Java heap, and players over the same hour." },
      { x: 78, y: 22.7, text: "Five minutes to an hour. Hover or touch a chart to read a moment." },
    ],
  },
  {
    key: "plugins",
    label: "Plugins",
    alt: "Plugin browser with Modrinth results marked as compatible with Minecraft 1.21.4",
    spots: [
      { x: 95.5, y: 22.5, text: "Plugins are code. CraftPanel says so, every time." },
      { x: 30, y: 57.4, text: "Switch between Modrinth and Hangar." },
      { x: 44, y: 74.6, text: "Checked against your exact Minecraft version before you install." },
      { x: 89, y: 75.1, text: "One click. The download is verified against its checksum." },
    ],
  },
  {
    key: "assistant",
    label: "Assistant",
    alt: "The optional AI assistant beside the server overview, asking for approval before it whitelists a player",
    spots: [
      { x: 95, y: 15.8, text: "Ask in plain words. It reads status, players and the console for you." },
      { x: 85.5, y: 32.7, text: "Changes wait for Approve. Decline, and nothing happens." },
      { x: 80, y: 3.5, text: "Optional, with your own key: Claude, OpenAI or a local model." },
    ],
  },
  {
    key: "servers",
    label: "All servers",
    alt: "Server list with a running Paper server and two stopped servers",
    spots: [
      { x: 42.5, y: 19.7, text: "Status at a glance: running, stopped, starting, crashed." },
      { x: 87.5, y: 7.8, text: "The eight-step wizard: software, version, world, memory, network." },
      { x: 15.5, y: 42, text: "Every server one click away, with its player count." },
    ],
  },
] as const;

const devices = [
  { name: "The PC under your desk", os: "Windows · Linux · macOS", scene: pcScene(), ram: "4–8 GB", players: "10–30", note: "Automatic services on Windows and Linux; manual setup on macOS. Your gaming PC works too: Minecraft servers don't use the GPU." },
  { name: "Raspberry Pi 4 / 5", os: "64-bit Raspberry Pi OS", scene: piScene(), ram: "2–3 GB", players: "2–8", note: "Draws a few watts. Pick the Pi preset, pre-generate the world, keep worlds on an SSD." },
  { name: "A small VPS", os: "Linux with systemd", scene: vpsScene(), ram: "4–8 GB", players: "10–20", note: "Choose a plan with a public IP and allow the Minecraft port in its firewall. Keep the dashboard behind a VPN, SSH tunnel or HTTPS reverse proxy." },
];

// Each cell is marked as a strength (+), a trade-off (−) or "it depends" (~), so the table reads at a glance.
type Mark = "pro" | "con" | "mid";
const marks: Record<Mark, { icon: UiIconName; label: string }> = {
  pro: { icon: "plus", label: "Strength" },
  con: { icon: "minus", label: "Trade-off" },
  mid: { icon: "tilde", label: "Depends" },
};
const compare: { cols: [string, string]; rows: { aspect: string; cells: [Mark, string][] }[] } = {
  cols: ["CraftPanel on your machine", "Managed Minecraft hosting"],
  rows: [
    { aspect: "Cost", cells: [["pro", "Free panel. You pay for power, or for a VPS."], ["con", "A monthly fee, by plan and memory."]] },
    { aspect: "Files & worlds", cells: [["pro", "Every file on your own disk."], ["mid", "Through the host's file manager or SFTP, by plan."]] },
    { aspect: "Server software", cells: [["pro", "Paper, Purpur, Fabric, NeoForge, Vanilla or Velocity."], ["mid", "What the host offers."]] },
    { aspect: "Upkeep", cells: [["con", "Yours: the machine, its updates, the network. Backups run on a schedule."], ["pro", "The host looks after hardware and network."]] },
    { aspect: "Uptime", cells: [["con", "As long as your machine is on."], ["pro", "Data-centre hardware, on around the clock."]] },
    { aspect: "Reaching players", cells: [["mid", "Port forwarding or a VPS. CraftPanel checks whether friends can join."], ["pro", "A public address is included."]] },
    { aspect: "Getting started", cells: [["mid", "One-line installer on Linux and Windows; manual setup on macOS."], ["pro", "Sign up and pick a plan."]] },
  ],
};
const choices: { title: string; text: string; link?: { href: string; label: string } }[] = [
  { title: "Run CraftPanel if…", text: "you have a spare PC, a Raspberry Pi or a VPS, and want your worlds and settings on hardware you control.", link: { href: "#install", label: "Install it" } },
  { title: "Rent a server if…", text: "nobody wants to look after a machine or a router, and the server has to stay online around the clock." },
  { title: "Pick another panel if…", text: "you run many machines or games: Pterodactyl spreads servers across nodes in Docker, Crafty Controller also runs Bedrock. CraftPanel manages one host today; more are planned." },
];

const faqs: { id: string; q: string; a: string; more?: { href: string; label: string } }[] = [
  { id: "cost", q: "What does it cost?", a: "The CraftPanel software is free. You pay for hardware, electricity and any VPS or connectivity you use. It is source-available under FSL-1.1-ALv2, which restricts competing commercial uses. Each version becomes Apache-2.0 after two years.", more: { href: `${github}/blob/main/LICENSE`, label: "Read the license" } },
  { id: "hardware", q: "What hardware do I need?", a: "Anything that runs Node.js 22.13 or newer: a Windows or Linux PC, a Mac, a Raspberry Pi 4/5 with a 64-bit OS, or a small VPS. Minecraft needs most of the memory: about 2 GB for a small Paper server, 4 GB or more for modpacks.", more: { href: "/docs/getting-started/installation/", label: "Installation guide" } },
  { id: "join", q: "How do my friends join?", a: "At home they use the LAN address on the server's overview. Over the internet, forward the game port in your router, let friends join a VPN such as Tailscale, or run CraftPanel on a VPS. The Network tab checks whether the port is reachable and tells you when your provider's CGNAT rules out port forwarding.", more: { href: "/docs/guides/networking/", label: "Networking" } },
  { id: "offline", q: "What happens when my computer is off?", a: "Your servers are offline too; that is the trade-off of running them yourself. When the machine starts again, CraftPanel starts with it and brings back the servers set to start with CraftPanel. For a server that is always on, use a Raspberry Pi or a small VPS.", more: { href: "/docs/administration/maintenance/", label: "Maintenance" } },
  { id: "backups", q: "How do backups and updates work?", a: "Schedule backups per server and keep the newest few. A restore checks the archive and saves the current state first. Most updates install from the browser while Minecraft keeps running; the rare runtime update asks first and restarts the servers once.", more: { href: "/docs/getting-started/updating/", label: "Updating" } },
  { id: "bedrock", q: "Bedrock?", a: "Not yet. CraftPanel runs Minecraft Java Edition servers. A Bedrock adapter is on the roadmap." },
  { id: "world", q: "Can I bring my existing world?", a: "Yes. Create a server with the same software and version, then import the world as a zip in the Worlds tab, or upload files in the file manager.", more: { href: "/docs/guides/worlds-and-backups/", label: "Worlds and backups" } },
  { id: "internet", q: "Should I open the dashboard to the internet?", a: "No. Only the Minecraft port should be public. Reach the dashboard through a VPN like Tailscale, an SSH tunnel or an HTTPS reverse proxy. By default CraftPanel only lets in private networks and refuses public clients without HTTPS.", more: { href: "/docs/administration/remote-access/", label: "Remote access" } },
  { id: "ai", q: "Is there AI in it?", a: "Only if you want it. The optional assistant is off until the owner adds their own key for Claude, OpenAI or a local model such as Ollama. It acts with the asking user's permissions and asks before it changes anything.", more: { href: "/docs/guides/ai-assistant/", label: "AI assistant" } },
  { id: "privacy", q: "Does it phone home?", a: "No telemetry and no CraftPanel cloud account. You create local users on your installation. CraftPanel goes online for official downloads, Modrinth and Hangar when you browse add-ons, and an optional update check against GitHub.", more: { href: "/docs/reference/security/", label: "Security and privacy" } },
];

const backups = [
  { when: "Today 04:00", size: "1.24 GB", tag: "nightly" },
  { when: "Yesterday 04:00", size: "1.23 GB", tag: "nightly" },
  { when: "Sun 03:00", size: "1.20 GB", tag: "weekly" },
  { when: "Before 1.21.4", size: "1.18 GB", tag: "manual" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://craftpanel.vctr.site/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://craftpanel.vctr.site/" />
    <meta property="og:image" content="https://craftpanel.vctr.site/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#171614" />
    <script is:inline>
      // Same storage key as Starlight, so the docs and this page share the theme choice.
      (() => {
        let stored = "";
        try { stored = localStorage.getItem("starlight-theme") || ""; } catch {}
        const theme = stored === "light" || stored === "dark" ? stored : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-in">
        <a href="/" class="brand"><Wordmark /></a>
        <nav aria-label="Main" class="nav-links">
          <a href="#features">Features</a>
          <a href="#dashboard">Dashboard</a>
          <a href="#security">Security</a>
          <a href="#compare">Compare</a>
          <a href="/docs/">Docs</a>
        </nav>
        <div class="nav-end">
          <a class="nav-gh" href={github}>
            <UiIcon name="github" size={24} />
            <span class="hide-sm">GitHub</span>
            {facts.stars !== null && facts.stars >= 10 && <span class="nav-stars"><UiIcon name="star" size={12} />{facts.stars}</span>}
          </a>
          <button class="nav-theme" id="theme-toggle" type="button" aria-label="Switch between dark and light mode">
            <UiIcon name="sun" size={24} class="if-dark" />
            <UiIcon name="moon" size={24} class="if-light" />
          </button>
          <a class="nav-install" href="#install">Install</a>
          <!-- The links of the bar, for screens too narrow to show them. -->
          <details class="nav-menu">
            <summary aria-label="Menu"><UiIcon name="menu" size={24} /></summary>
            <nav aria-label="Main, compact" class="nav-menu-list">
              <a href="#features">Features</a>
              <a href="#dashboard">Dashboard</a>
              <a href="#security">Security</a>
              <a href="#compare">Compare</a>
              <a href="/docs/">Docs</a>
              <a href={github} rel="noopener">GitHub</a>
            </nav>
          </details>
        </div>
      </div>
      <!-- Scroll progress as a Minecraft experience bar; the level is the section you are reading. -->
      <div class="xp" aria-hidden="true">
        <span class="xp-fill"></span>
        <span class="xp-level mono" data-xp-level><b></b><span></span></span>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero" id="install" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="hero-kicker mono"><span class="px-dot" aria-hidden="true"></span><a href={release.url}>{release.tag}</a> · self-hosted Minecraft panel</p>
            <h1 id="hero-title" class="display"><span class="h-line">Your server.</span><br /><span class="h-line">Your hardware.</span><br /><span class="h-line"><span class="mark">No panel fee.</span></span></h1>
            <p class="hero-lead">
              A Minecraft Java server for you and your friends, on your own PC, Raspberry Pi or VPS. Create it, update it and back it up from your browser.
            </p>
            <Terminal version={version} id="hero-term" />
            <div class="hero-next">
              <a class="hero-link" href="#dashboard">See the dashboard <span aria-hidden="true">↓</span></a>
              <a class="hero-link" href="/docs/getting-started/installation/">Installation guide <span aria-hidden="true">↗</span></a>
            </div>
            <ul class="hero-facts mono" aria-label="Supported platforms">
              <li>Windows · Linux · macOS</li>
              <li>x64 · ARM64 · Raspberry Pi</li>
              <li>No Docker, no Java setup</li>
            </ul>
          </div>
          <div class="hero-art" aria-hidden="false">
            <div class="hero-scene">
              <Iso boxes={heroScene()} label="A Raspberry Pi with a small Minecraft world floating above it" class="iso hero-iso" />
