---
import { Image } from "astro:assets";
import "../styles/fonts.css";
import "../styles/landing.css";
import Icon from "../components/Icon.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Shot from "../components/Shot.astro";
// release.mjs bumps every workspace package, so this matches the latest release.
import pkg from "../../package.json";
import logo from "../assets/logo.svg";

const version = pkg.version;
const github = "https://github.com/vctrchappot/CraftPanel";
const title = "CraftPanel – Self-hosted Minecraft server manager";
const description =
  "Run Paper, Purpur, Fabric, NeoForge, Vanilla and Velocity servers on your own PC, Raspberry Pi or VPS, and manage them from the browser. No cloud, no accounts, no telemetry.";

const software = [
  { name: "Paper", note: "Plugins, best performance" },
  { name: "Purpur", note: "Paper with extra options" },
  { name: "Fabric", note: "Lightweight mods" },
  { name: "NeoForge", note: "Big mods and modpacks" },
  { name: "Vanilla", note: "Official Mojang server" },
  { name: "Velocity", note: "Proxy for several servers" },
];

const features = [
  { icon: "terminal", title: "Live console and metrics", text: "Console over WebSockets with history and filters, plus real CPU, memory, TPS and player counts." },
  { icon: "puzzle", title: "Plugins, mods and modpacks", text: "Search Modrinth and Hangar, install with checksum verification, get update suggestions, or start from a Modrinth modpack." },
  { icon: "archive", title: "Backups you can trust", text: "Consistent live backups, scheduled and verified, with one-click restore and an automatic safety backup first." },
  { icon: "refresh", title: "Updates that keep players online", text: "Minecraft runs in its own service. Restarting or updating the dashboard never stops your games; failed updates roll back." },
  { icon: "users", title: "Built for teams", text: "Owner, Administrator, Operator and Viewer roles, per-server access, two-factor sign-in and an audit log." },
  { icon: "coffee", title: "Java handled for you", text: "The right Eclipse Temurin version is downloaded for each Minecraft version, on x64 and ARM64." },
  { icon: "activity", title: "Automation", text: "Restarts, backups, announcements and commands on a schedule, with presets and a run history." },
  { icon: "bell", title: "Notifications", text: "Discord or e-mail when a server crashes, a backup fails or a new CraftPanel release is out." },
  { icon: "globe", title: "Networking without guesswork", text: "Copyable addresses, port and CGNAT checks, optional DuckDNS, and a clear path to remote access." },
] as const;

const faqs = [
  { q: "What does it cost?", a: "Nothing. CraftPanel is source-available under the Functional Source License (FSL-1.1-ALv2): free to use, change and share for any purpose except a competing commercial product. Each version becomes Apache-2.0 after two years." },
  { q: "What hardware do I need?", a: "Anything that runs Node.js 22.13+: a Windows or Linux PC, a Mac, a Raspberry Pi 4/5 with a 64-bit OS, or a small VPS. Minecraft itself needs most of the memory: plan 2 GB for a small Paper server and 4 GB or more for modpacks." },
  { q: "Does it support Bedrock?", a: "Not yet. CraftPanel manages Minecraft Java Edition servers. A Bedrock Dedicated Server adapter is on the roadmap." },
  { q: "Can I move my existing server into CraftPanel?", a: "Yes. Create a server with the same software and version, then import your world as a zip in the Worlds tab or upload files in the file manager." },
  { q: "Is it safe to open to the internet?", a: "Only the Minecraft port should be public. Reach the dashboard over a VPN such as Tailscale, an SSH tunnel or an HTTPS reverse proxy. By default CraftPanel only accepts private networks and refuses public clients without HTTPS." },
  { q: "Does CraftPanel phone home?", a: "No telemetry, no account, no cloud. It only contacts official download sources, Modrinth or Hangar when you browse add-ons, and GitHub for the optional update check." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://craftpanel.vctr.site/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://craftpanel.vctr.site/" />
    <meta property="og:image" content="https://craftpanel.vctr.site/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0a" />
    <script is:inline>
      // Same storage key as Starlight, so the docs and this page share the theme choice.
      (() => {
        let stored = "";
        try { stored = localStorage.getItem("starlight-theme") || ""; } catch {}
        const theme = stored === "light" || stored === "dark" ? stored : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="container nav-inner">
        <a href="/" class="brand"><Image src={logo} alt="" width={28} height={28} /> CraftPanel</a>
        <nav aria-label="Main" class="nav-links">
          <a href="#features">Features</a>
          <a href="#install">Install</a>
          <a href="#faq">FAQ</a>
          <a href="/docs/">Docs</a>
        </nav>
        <div class="nav-actions">
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
            <Icon name="sun" class="if-dark" size={18} />
            <Icon name="moon" class="if-light" size={18} />
          </button>
          <a class="icon-btn" href={github} aria-label="CraftPanel on GitHub"><Icon name="github" size={18} /></a>
          <a class="btn btn-primary btn-sm hide-sm" href="/docs/getting-started/installation/">Get started</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="container hero-inner">
          <a class="pill" href={`${github}/releases/tag/v${version}`}>
            <span class="pill-dot"></span> v{version} · first stable release <Icon name="arrowRight" size={14} />
          </a>
          <h1>Minecraft servers on your own hardware. <span class="muted">Managed from the browser.</span></h1>
          <p class="lead">
            Install CraftPanel on a PC, a Raspberry Pi or a VPS, open the dashboard and create real Minecraft Java servers in a few clicks. No Docker, no Java setup, no cloud.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="/docs/getting-started/installation/">Get started <Icon name="arrowRight" size={16} /></a>
            <a class="btn btn-ghost" href={github}><Icon name="github" size={16} /> View on GitHub</a>
          </div>
          <InstallCommand />
          <p class="hero-meta">Free and source-available · Windows, Linux, macOS · x64 and ARM64</p>
        </div>
        <div class="container">
          <Shot name="overview" alt="CraftPanel server overview with player count, CPU, memory, live console and connection addresses" priority />
        </div>
      </section>

      <section class="strip" aria-label="Supported server software">
        <div class="container strip-inner">
          {software.map((s) => (
            <div class="strip-item">
              <span class="strip-name">{s.name}</span>
              <span class="strip-note">{s.note}</span>
            </div>
          ))}
        </div>
      </section>

      <section id="features" class="section">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Features</p>
            <h2>Everything a server admin does, in one calm dashboard.</h2>
            <p class="section-lead">From the first world to a team running several servers behind a proxy: CraftPanel covers the daily work and stays out of the way.</p>
          </div>
          <div class="feature-grid">
            {features.map((f) => (
              <article class="feature">
                <div class="feature-icon"><Icon name={f.icon} /></div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section-alt" aria-labelledby="tour-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">A closer look</p>
            <h2 id="tour-title">Designed to be understood at a glance.</h2>
          </div>
          <div class="tour" data-tour>
            <div class="tour-tabs" role="tablist" aria-label="Dashboard screens">
              <button role="tab" aria-selected="true" aria-controls="tour-wizard" id="tab-wizard">Create a server</button>
              <button role="tab" aria-selected="false" aria-controls="tour-console" id="tab-console" tabindex="-1">Console</button>
              <button role="tab" aria-selected="false" aria-controls="tour-plugins" id="tab-plugins" tabindex="-1">Plugins</button>
              <button role="tab" aria-selected="false" aria-controls="tour-servers" id="tab-servers" tabindex="-1">All servers</button>
            </div>
            <div role="tabpanel" id="tour-wizard" aria-labelledby="tab-wizard">
              <p class="tour-caption">A guided wizard: pick the software, version, world and memory. CraftPanel downloads everything from official sources and checks every file.</p>
              <Shot name="new-server" alt="Server creation wizard with Paper, Purpur, Fabric, NeoForge, Vanilla, Velocity and Modpack options" />
            </div>
            <div role="tabpanel" id="tour-console" aria-labelledby="tab-console" hidden>
              <p class="tour-caption">The real server console, live. Filter by level, browse command history, download the log. Commands go to Minecraft only, never to a system shell.</p>
              <Shot name="console" alt="Live Minecraft console with filter, command input and server output" />
            </div>
            <div role="tabpanel" id="tour-plugins" aria-labelledby="tab-plugins" hidden>
              <p class="tour-caption">Browse Modrinth and Hangar with compatibility badges for your exact Minecraft version, install in one click, and get updates later.</p>
              <Shot name="plugins" alt="Plugin browser listing Modrinth plugins compatible with Minecraft 1.21.4" />
            </div>
            <div role="tabpanel" id="tour-servers" aria-labelledby="tab-servers" hidden>
              <p class="tour-caption">Every server at a glance, with status, software, players and memory.</p>
              <Shot name="servers" alt="Server list with a running Paper server and a stopped Fabric server" />
            </div>
          </div>
        </div>
      </section>

      <section id="install" class="section">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Get started</p>
            <h2>Up and running in three steps.</h2>
          </div>
          <ol class="steps">
            <li class="step">
              <span class="step-num">1</span>
              <h3>Install</h3>
              <p>Run one command on the machine that should host your servers. The installer sets up Node.js if needed and runs CraftPanel in the background.</p>
            </li>
            <li class="step">
              <span class="step-num">2</span>
              <h3>Open the dashboard</h3>
              <p>Go to <code>http://&lt;host&gt;:8080</code> and create the owner account with the one-time setup token the installer printed.</p>
            </li>
            <li class="step">
              <span class="step-num">3</span>
              <h3>Create a server</h3>
              <p>Pick Paper, Fabric or a modpack, accept the Minecraft EULA, and press Start. Java and the server software are downloaded for you.</p>
            </li>
          </ol>
          <div class="install-card">
            <InstallCommand large />
            <p class="install-note">
              Prefer to build it yourself? <a href="/docs/getting-started/installation/#from-source">Run from source</a> with Node.js and pnpm. Detailed guides for <a href="/docs/getting-started/installation/#raspberry-pi">Raspberry Pi</a> and <a href="/docs/administration/remote-access/">remote access</a> are in the docs.
            </p>
          </div>
        </div>
      </section>

      <section class="section section-alt">
        <div class="container split">
          <div>
            <p class="eyebrow">Security and privacy</p>
            <h2>Your servers. Your machine. Your data.</h2>
            <p class="section-lead">CraftPanel is built for people who host at home or on a small VPS and don't want to think about attack surfaces all day.</p>
            <a class="text-link" href="/docs/reference/security/">Read the security model <Icon name="arrowRight" size={16} /></a>
          </div>
          <ul class="checklist">
            <li><Icon name="eyeOff" /><div><strong>No telemetry, no account.</strong> Nothing about your install leaves the machine.</div></li>
            <li><Icon name="shield" /><div><strong>Verified downloads.</strong> Server software, Java and add-ons come from official sources and are checked against published checksums.</div></li>
            <li><Icon name="key" /><div><strong>Locked down by default.</strong> Private networks only, a setup token for the first account, HTTPS required for public access.</div></li>
            <li><Icon name="terminal" /><div><strong>No shell, ever.</strong> Processes start with explicit arguments; the console reaches Minecraft, not your system.</div></li>
          </ul>
        </div>
      </section>

      <section id="faq" class="section">
        <div class="container narrow">
          <div class="section-head">
            <p class="eyebrow">FAQ</p>
            <h2>Questions, answered.</h2>
          </div>
          <div class="faq">
            {faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section cta">
        <div class="container cta-inner">
          <h2>Start your first server tonight.</h2>
          <p class="section-lead">One command to install. A few clicks to play.</p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="/docs/getting-started/installation/">Install CraftPanel <Icon name="arrowRight" size={16} /></a>
            <a class="btn btn-ghost" href="/docs/"><Icon name="book" size={16} /> Read the docs</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a href="/" class="brand"><Image src={logo} alt="" width={24} height={24} /> CraftPanel</a>
          <p>Self-hosted Minecraft server management. Made by <a href="https://www.vctr.site">Victor</a>.</p>
        </div>
        <div class="footer-cols">
          <div>
            <h4>Product</h4>
            <a href="#features">Features</a>
            <a href="/docs/getting-started/installation/">Install</a>
            <a href={`${github}/releases`}>Releases</a>
            <a href={`${github}/blob/main/CHANGELOG.md`}>Changelog</a>
          </div>
          <div>
            <h4>Docs</h4>
            <a href="/docs/">Introduction</a>
            <a href="/docs/getting-started/first-server/">First server</a>
            <a href="/docs/administration/remote-access/">Remote access</a>
            <a href="/docs/reference/troubleshooting/">Troubleshooting</a>
          </div>
          <div>
            <h4>Project</h4>
            <a href={github}>GitHub</a>
            <a href={`${github}/issues`}>Issues</a>
            <a href={`${github}/blob/main/LICENSE`}>License (FSL-1.1-ALv2)</a>
          </div>
        </div>
      </div>
      <div class="container footer-legal">
        <p>Minecraft is a trademark of Mojang AB. CraftPanel is not affiliated with Mojang or Microsoft and never redistributes server software.</p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("starlight-theme", next); } catch {}
      });

      for (const block of document.querySelectorAll<HTMLElement>("[data-install]")) {
        const tabs = [...block.querySelectorAll<HTMLButtonElement>("[role=tab]")];
        const select = (tab: HTMLButtonElement) => {
          for (const t of tabs) {
            const active = t === tab;
            t.setAttribute("aria-selected", String(active));
            t.tabIndex = active ? 0 : -1;
            block.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !active;
          }
        };
        tabs.forEach((t) => t.addEventListener("click", () => select(t)));
        if (/Windows/i.test(navigator.userAgent)) select(tabs.find((t) => t.dataset.os === "windows") ?? tabs[0]);
        for (const btn of block.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
          btn.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(btn.dataset.copy ?? "");
              btn.classList.add("copied");
              setTimeout(() => btn.classList.remove("copied"), 1600);
            } catch {}
          });
        }
      }

      for (const tour of document.querySelectorAll<HTMLElement>("[data-tour]")) {
        const tabs = [...tour.querySelectorAll<HTMLButtonElement>("[role=tab]")];
        const select = (tab: HTMLButtonElement) => {
          for (const t of tabs) {
            const active = t === tab;
            t.setAttribute("aria-selected", String(active));
            t.tabIndex = active ? 0 : -1;
            tour.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !active;
          }
        };
        tabs.forEach((t, i) => {
          t.addEventListener("click", () => select(t));
          t.addEventListener("keydown", (e) => {
            const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
            if (!d) return;
            const next = tabs[(i + d + tabs.length) % tabs.length];
            select(next);
            next.focus();
          });
        });
      }
    </script>
  </body>
</html>
