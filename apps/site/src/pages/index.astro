        </div>
      </section>

      <!-- Who it's for -->
      <section class="sec sec-audience" aria-labelledby="audience-title">
        <div class="wrap">
          <h2 id="audience-title" class="display">Who runs CraftPanel?</h2>
          <ul class="choices audiences">
            {audiences.map((a) => (
              <li class="choice">
                <h3>{a.title}</h3>
                <p class="aud-q">“{a.question}”</p>
