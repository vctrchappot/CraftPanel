---
import "../styles/frame.css";
import { Image } from "astro:assets";
import Pixel from "../components/Pixel.astro";
import UiIcon from "../components/UiIcon.astro";
import type { PixelName } from "../lib/pixel-icons";
import type { UiIconName } from "../lib/ui-icons";
import Iso from "../components/Iso.astro";
import Terminal from "../components/Terminal.astro";
import RuntimeDiagram from "../components/RuntimeDiagram.astro";
import DashboardMock from "../components/home/DashboardMock.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import FaqSection from "../components/FaqSection.astro";
import { heroScene, isolationScene, pcScene, piScene, vpsScene } from "../lib/scenes";
import { repoFacts, shownRelease } from "../lib/github";
import { faqJsonLd, type Faq } from "../lib/faq";
// release.mjs bumps every workspace package, so this matches the latest release.
import pkg from "../../package.json";
import avatar from "../assets/victor.jpg";

const facts = await repoFacts();
const version = pkg.version;
const release = shownRelease(facts.release, version);
const releaseDate = release.date ? new Date(release.date).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : "";
const github = "https://github.com/vctrchappot/CraftPanel";
const title = "CraftPanel – Your Minecraft server, on your hardware";
const description =
  "Self-hosted panel for Minecraft Java servers on a PC, a Raspberry Pi or a VPS. Paper, Purpur, Fabric, NeoForge, Vanilla and Velocity. No panel fee, no telemetry.";

const software: { name: string; icon: PixelName; note: string; kind: string }[] = [
  { name: "Paper", icon: "paper", note: "Plugins, fast and Vanilla-like.", kind: "plugins" },
  { name: "Purpur", icon: "purpur", note: "Paper with more settings.", kind: "plugins" },
  { name: "Fabric", icon: "fabric", note: "Light mods like Lithium.", kind: "mods" },
  { name: "NeoForge", icon: "neoforge", note: "Big mods and modpacks.", kind: "mods" },
  { name: "Vanilla", icon: "vanilla", note: "Mojang's server, untouched.", kind: "unmodified" },
  { name: "Velocity", icon: "velocity", note: "Several servers, one address.", kind: "proxy" },
];

type Spec = [key: string, value: string];
// Each chapter: a short text, one large visual (rendered below by id) and a strip of facts. Facts say where they hold.
const chapters: { id: string; label: string; title: string; dim: string; text: string[]; specs: Spec[] }[] = [
  {
    id: "isolation",
    label: "Isolation",
    title: "Limits per server,",
    dim: "set by the operating system.",
    text: [
      "On Linux service installs and on Windows every server gets a memory cap, a process limit and, if you want one, a CPU limit. A modpack that wants every gigabyte stays inside its share, and the rest of the host stays responsive.",
      "On Linux service installs each server also runs under its own system account, so a plugin can't read the panel's database or another server's files.",
    ],
    specs: [["memory cap", "on by default"], ["processes", "4,096 by default"], ["changes", "apply to a running server"], ["own account", "Linux service installs"]],
  },
  {
    id: "updates",
    label: "Updates",
    title: "Update the dashboard",
    dim: "while players stay online.",
    text: [
      "Minecraft runs in its own service. The dashboard can restart, crash or update, and finds its running servers again afterwards.",
      "A release that fails to start is rolled back together with its database. Try both outcomes in the drawing.",
    ],
    specs: [["dashboard update", "Minecraft keeps running"], ["failed start", "rolled back"], ["runtime update", "asks first"]],
  },
  {
    id: "backups",
    label: "Backups",
    title: "Backups on a schedule,",
    dim: "restored from the list.",
    text: [
      "Schedule backups per server and keep the newest few. A restore checks the archive first and saves the current state, in case you need it after all.",
    ],
    specs: [["schedule", "presets or cron"], ["restore", "verified, safety copy first"], ["retention", "newest n per server"]],
  },
  {
    id: "plugins",
    label: "Plugins",
    title: "Plugins and mods",
    dim: "from Modrinth and Hangar.",
    text: [
      "Search both sources from the server, see which results fit your exact Minecraft version and loader, and install with a checksum check.",
      "Modpacks start from a Modrinth pack; the Minecraft and loader versions come from the pack.",
    ],
    specs: [["sources", "Modrinth, Hangar"], ["fit", "checked per version"], ["downloads", "checksum verified"]],
  },
  {
    id: "performance",
    label: "Performance",
    title: "Lag, measured",
    dim: "and explained.",
    text: [
      "TPS, tick time, CPU and memory over the last hour. Slow ticks are marked, and insights say what would help: a view distance that suits the machine, tuned garbage-collector flags, or pre-generating the world.",
    ],
    specs: [["range", "5 min to 1 h"], ["tick budget", "50 ms"], ["pre-generation", "Chunky, one click"]],
  },
  {
    id: "assistant",
    label: "Assistant",
    title: "An assistant,",
    dim: "if you want one.",
    text: [
      "Off until the owner adds a key for Claude, OpenAI or another provider, or points it at a local model in Ollama or LM Studio. It reads status, players and the console, acts with the asking user's permissions, and every change waits for an approval.",
    ],
    specs: [["default", "off"], ["providers", "Claude, OpenAI, Gemini, local, more"], ["changes", "wait for approval"]],
  },
  {
    id: "security",
    label: "Security",
    title: "What a request passes",
    dim: "on its way to Minecraft.",
    text: [
      "The dashboard only lets in private networks by default and refuses public clients without HTTPS. Every route checks the user's role, and the runtime only listens to its private token.",
      "Downloads come from official hosts and are checked against their checksums. Nothing phones home.",
    ],
    specs: [["telemetry", "none"], ["sign-in", "two-factor, rate-limited"], ["audit log", "who did what"]],
  },
];

const lanes: { name: string; software: string; memory: [number, number]; cpu: [number, number]; note: string; hot?: boolean }[] = [
  { name: "survival", software: "Paper", memory: [2.1, 3.4], cpu: [1.2, 2], note: "within its limits" },
  { name: "lobby", software: "Velocity", memory: [0.4, 1.5], cpu: [0.1, 1], note: "within its limits" },
  { name: "modpack", software: "NeoForge", memory: [6.9, 7], cpu: [2, 2], note: "at its cap · the others keep running", hot: true },
];
const hops: { icon: UiIconName; name: string; where: string; checks: string[] }[] = [
  { icon: "lock", name: "Browser", where: "your device", checks: ["HTTPS, built in or behind a proxy", "private networks only by default"] },
  { icon: "users", name: "Dashboard", where: "web app", checks: ["sign-in with two-factor", "role checked on every request", "files only inside the server folder"] },
  { icon: "box", name: "Runtime", where: "own service", checks: ["private token, local socket", "Java started without a shell", "commands go to Minecraft only"] },
  { icon: "blocks", name: "Minecraft", where: "per server", checks: ["memory, CPU and process limits", "own account on Linux service installs"] },
];
const backups = [
  { when: "Today 04:00", size: "1.24 GB", tag: "nightly" },
  { when: "Yesterday 04:00", size: "1.23 GB", tag: "nightly" },
  { when: "Sun 03:00", size: "1.20 GB", tag: "weekly" },
  { when: "Before 1.21.4", size: "1.18 GB", tag: "manual" },
];
const extras: { icon: UiIconName; title: string; text: string }[] = [
  { icon: "users", title: "Teams", text: "Roles per server, two-factor sign-in and an audit log." },
  { icon: "cup", title: "Java, handled", text: "The right Java for every Minecraft version, per server." },
  { icon: "clock", title: "Schedules", text: "Restarts with a warning in chat, backups, commands." },
  { icon: "bell", title: "Alerts", text: "Discord or e-mail when a server crashes or a backup fails." },
  { icon: "signal", title: "Network checks", text: "Addresses to share, port checks, CGNAT detection, DuckDNS." },
  { icon: "folder", title: "Files and worlds", text: "Edit configs in the browser, import and export worlds." },
];

const devices = [
  { name: "The PC under your desk", os: "Windows · Linux · macOS", scene: pcScene(), ram: "4–8 GB", players: "10–30", href: "/windows/" },
  { name: "Raspberry Pi 4 / 5", os: "64-bit Raspberry Pi OS", scene: piScene(), ram: "2–3 GB", players: "2–8", href: "/raspberry-pi/" },
  { name: "A small VPS", os: "Linux with systemd", scene: vpsScene(), ram: "4–8 GB", players: "10–20", href: "/docs/getting-started/installation/" },
];

// Each cell is marked as a strength (+), a trade-off (−) or "it depends" (~), so the table reads at a glance.
type Mark = "pro" | "con" | "mid";
const marks: Record<Mark, { icon: UiIconName; label: string }> = {
  pro: { icon: "plus", label: "Strength" },
  con: { icon: "minus", label: "Trade-off" },
  mid: { icon: "tilde", label: "Depends" },
};
const compare: { aspect: string; cells: [Mark, string][] }[] = [
  { aspect: "Cost", cells: [["pro", "Free panel. You pay for power, or for a VPS."], ["con", "A monthly fee, by plan and memory."]] },
  { aspect: "Files & worlds", cells: [["pro", "Every file on your own disk."], ["mid", "Through the host's file manager or SFTP."]] },
  { aspect: "Server software", cells: [["pro", "Paper, Purpur, Fabric, NeoForge, Vanilla or Velocity."], ["mid", "What the host offers."]] },
  { aspect: "Upkeep", cells: [["con", "Yours: the machine, its updates, the network."], ["pro", "The host looks after hardware and network."]] },
  { aspect: "Uptime", cells: [["con", "As long as your machine is on."], ["pro", "Data-centre hardware, around the clock."]] },
  { aspect: "Reaching players", cells: [["mid", "Port forwarding or a VPS; CraftPanel checks it."], ["pro", "A public address is included."]] },
];

const faqs: Faq[] = [
  { id: "cost", q: "What does it cost?", a: "The CraftPanel software is free. You pay for hardware, electricity and any VPS or connectivity you use. It is source-available under FSL-1.1-ALv2, which restricts competing commercial uses. Each version becomes Apache-2.0 after two years.", more: { href: `${github}/blob/main/LICENSE`, label: "Read the license" } },
  { id: "hardware", q: "What hardware do I need?", a: "Anything that runs Node.js 22.13 or newer: a Windows or Linux PC, a Mac, a Raspberry Pi 4/5 with a 64-bit OS, or a small VPS. Minecraft needs most of the memory: about 2 GB for a small Paper server, 4 GB or more for modpacks.", more: { href: "/docs/getting-started/installation/", label: "Installation guide" } },
  { id: "join", q: "How do my friends join?", a: "At home they use the LAN address on the server's overview. Over the internet, forward the game port in your router, let friends join a VPN such as Tailscale, or run CraftPanel on a VPS. The Network tab checks whether the port is reachable and tells you when your provider's CGNAT rules out port forwarding.", more: { href: "/play-with-friends/", label: "Four ways to let friends join" } },
  { id: "offline", q: "What happens when my computer is off?", a: "Your servers are offline too; that is the trade-off of running them yourself. When the machine starts again, CraftPanel starts with it and brings back the servers set to start with CraftPanel. For a server that is always on, use a Raspberry Pi or a small VPS.", more: { href: "/docs/administration/maintenance/", label: "Maintenance" } },
  { id: "backups", q: "How do backups and updates work?", a: "Schedule backups per server and keep the newest few. A restore checks the archive and saves the current state first. Most updates install from the browser while Minecraft keeps running; the rare runtime update asks first and restarts the servers once.", more: { href: "/docs/getting-started/updating/", label: "Updating" } },
  { id: "bedrock", q: "Bedrock?", a: "Not yet. CraftPanel runs Minecraft Java Edition servers. A Bedrock adapter is on the roadmap." },
  { id: "world", q: "Can I bring my existing world?", a: "Yes. Create a server with the same software and version, then import the world as a zip in the Worlds tab, or upload files in the file manager.", more: { href: "/docs/guides/worlds-and-backups/", label: "Worlds and backups" } },
  { id: "internet", q: "Should I open the dashboard to the internet?", a: "No. Only the Minecraft port should be public. Reach the dashboard through a VPN like Tailscale, an SSH tunnel or an HTTPS reverse proxy. By default CraftPanel only lets in private networks and refuses public clients without HTTPS.", more: { href: "/docs/administration/remote-access/", label: "Remote access" } },
  { id: "privacy", q: "Does it phone home?", a: "No telemetry and no CraftPanel cloud account. You create local users on your installation. CraftPanel goes online for official downloads, Modrinth and Hangar when you browse add-ons, and an optional update check against GitHub.", more: { href: "/docs/reference/security/", label: "Security and privacy" } },
];

const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "CraftPanel",
  description,
  url: "https://craftpanel.vctr.site/",
  downloadUrl: `${github}/releases/latest`,
  softwareVersion: version,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Windows, Linux, macOS",
  license: `${github}/blob/main/LICENSE`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Victor Chappot", url: "https://github.com/vctrchappot" },
};
const no = (i: number) => String(i).padStart(2, "0");
---

<SiteLayout title={title} description={description} path="/" jsonLd={[app, faqJsonLd(faqs)]}>
  <div class="frame">
    <!-- Hero: the claim, two ways in, the scene; the product itself in the row below -->
    <section class="row" aria-labelledby="hero-title">
      <div class="cells hero2">
        <div class="cell hero2-copy">
          <p class="kicker mono"><span class="px-dot" aria-hidden="true"></span><a href={release.url}>{release.tag}</a><span>Minecraft Java Edition</span><span>free</span></p>
          <h1 id="hero-title" class="display hero2-title">Your Minecraft server, <span class="dim">on your own hardware.</span></h1>
          <p class="hero2-lead">CraftPanel installs, runs, updates and backs up Paper, Purpur, Fabric, NeoForge, Vanilla and Velocity servers on a PC, a Raspberry Pi or a VPS. You manage them from a browser.</p>
          <div class="hero2-actions">
            <a class="btn btn-ink" href="#install">Install CraftPanel <UiIcon name="arrow-right" size={12} /></a>
            <a class="btn btn-outline" href={github} rel="noopener"><UiIcon name="github" size={24} />GitHub{facts.stars !== null && facts.stars >= 10 && <span class="btn-count mono">{facts.stars}</span>}</a>
          </div>
          <ul class="hero2-facts mono" aria-label="Platforms">
            <li>Windows · Linux · macOS</li>
            <li>x64 · ARM64</li>
            <li>no Docker needed</li>
          </ul>
        </div>
        <div class="cell cell-vis hero2-art">
          <Iso boxes={heroScene()} label="A Raspberry Pi with a small Minecraft world floating above it" class="iso night hero2-iso" />
          <p class="vis-tag mono" aria-hidden="true"><span class="px-dot"></span>raspberrypi.local · 4 GB · 3 online</p>
        </div>
      </div>
    </section>
    <section class="row row-mock" id="dashboard" aria-label="The dashboard">
      <div class="cell mock-cell">
        <DashboardMock />
        <p class="mock-caption mono">The server overview, as it looks in CraftPanel. The console and numbers are a recording.</p>
      </div>
    </section>

    <!-- What it is, in one sentence -->
    <section class="row" aria-label="Who CraftPanel is for">
      <p class="cell statement">A free panel for people who run their own Minecraft server: <span>friends on a Raspberry Pi, a family on the PC under the desk, a small community on a VPS.</span></p>
    </section>

    <!-- Server software -->
    <section class="row" aria-labelledby="soft-title">
      <h2 id="soft-title" class="sr-only">Server software</h2>
      <ul class="cells soft">
        {software.map((s) => (
          <li class="cell">
            <Pixel name={s.icon} size={48} />
            <p class="soft-name">{s.name}</p>
            <p class="soft-note">{s.note}</p>
            <p class="soft-kind mono">{s.kind}</p>
          </li>
        ))}
      </ul>
      <p class="cell row-foot mono"><span>Downloaded from the project that makes it · checksum checked · the right Java per server</span><a href="/docs/guides/server-software/">Server software <UiIcon name="arrow-right" size={12} /></a></p>
    </section>

    <!-- Chapters with a sticky index -->
    <div class="row chapters2" id="features">
      <nav class="chapter-index mono" aria-label="Features">
        {chapters.map((c, i) => <a href={`#${c.id}`} data-chapter={c.id}><span>{no(i + 1)}</span>{c.label}</a>)}
      </nav>
      <div class="chapter-list">
        {chapters.map((c, i) => (
          <section class="chapter2" id={c.id} aria-labelledby={`${c.id}-title`}>
            <div class="cells chapter2-cells">
              <div class="cell chapter2-copy">
                <p class="sec-no mono"><span>{no(i + 1)}</span>{c.label}</p>
                <h2 id={`${c.id}-title`} class="display">{c.title} <span class="dim">{c.dim}</span></h2>
                {c.text.map((t) => <p class="chapter2-text">{t}</p>)}
              </div>
              <div class:list={["cell", "cell-vis", `vis-${c.id}`]}>
                {c.id === "isolation" && (
                  <div class="iso-stage">
                    <Iso boxes={isolationScene()} label="Three Minecraft worlds on one machine, each under its own glass box; the third box is at its limit" class="iso night iso-lanes" />
                    <div class="lanes">
                      {lanes.map((l) => (
                        <div class:list={["lane", { "is-hot": l.hot }]}>
                          <p class="lane-head mono"><span class="lane-dot" aria-hidden="true" />{l.name}<span class="lane-sw">{l.software}</span></p>
                          <p class="meter mono"><span class="meter-k">memory</span><span class="meter-bar" style={`--v:${(l.memory[0] / l.memory[1]).toFixed(2)}`} aria-hidden="true"><i /></span><span class="meter-v">{l.memory[0].toFixed(1)} / {l.memory[1].toFixed(1)} GB</span></p>
                          <p class="meter mono"><span class="meter-k">cpu</span><span class="meter-bar" style={`--v:${(l.cpu[0] / l.cpu[1]).toFixed(2)}`} aria-hidden="true"><i /></span><span class="meter-v">{l.cpu[0].toFixed(1)} / {l.cpu[1]} cores</span></p>
                          <p class="lane-note mono">{l.note}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                {c.id === "updates" && <RuntimeDiagram />}
                {c.id === "backups" && (
                  <div class="demo-backup" data-backup>
                    <fieldset class="db-list">
                      <legend class="sr-only">Backups of survival</legend>
                      {backups.map((b, j) => (
                        <label class="db-item">
                          <input type="radio" name="backup" value={b.when} checked={j === 1} />
                          <span class="db-when">{b.when}</span>
                          <span class="db-size mono">{b.size}</span>
                          <span class="db-tag mono">{b.tag} · verified</span>
                        </label>
                      ))}
                    </fieldset>
                    <div class="db-foot">
                      <button type="button" class="btn btn-small btn-ink" data-restore>Restore</button>
                      <ol class="db-steps mono" aria-live="polite" data-steps></ol>
                    </div>
                  </div>
                )}
                {c.id === "plugins" && (
                  <div class="demo-search">
                    <p class="dp-field mono" aria-label="Example search for luck"><UiIcon name="search" size={12} /><span class="dp-query">luck</span><span class="dp-count">3 results · Paper 1.21.4</span></p>
                    <ul class="demo-plugins" aria-label="Example search results">
                      <li><span class="dp-name">LuckPerms</span><span class="dp-ok mono">supports 1.21.4</span><span class="dp-src mono">Modrinth</span></li>
                      <li><span class="dp-name">LuckPerms</span><span class="dp-ok mono">supports 1.21.4</span><span class="dp-src mono">Hangar</span></li>
                      <li><span class="dp-name">Lucky Block</span><span class="dp-warn mono">needs Fabric</span><span class="dp-src mono">Modrinth</span></li>
                    </ul>
                  </div>
                )}
                {c.id === "performance" && (
                  <figure class="demo-perf" data-perf>
                    <div class="dpf-head mono"><span>Tick time</span><span><b>18.6</b> ms avg · peak <b class="dpf-bad">71.4</b></span></div>
                    <svg class="dpf-chart" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true">
                      <line class="dpf-budget" x1="0" y1="40" x2="320" y2="40" />
                      <path class="dpf-area" d="M0 96 L20 94 L40 95 L60 92 L80 93 L100 90 L120 88 L140 70 L150 30 L160 18 L170 34 L180 62 L200 84 L220 86 L240 72 L250 36 L260 46 L270 78 L290 88 L320 90 L320 120 L0 120 Z" />
                      <path class="dpf-line" d="M0 96 L20 94 L40 95 L60 92 L80 93 L100 90 L120 88 L140 70 L150 30 L160 18 L170 34 L180 62 L200 84 L220 86 L240 72 L250 36 L260 46 L270 78 L290 88 L320 90" />
                      <rect class="dpf-mark" x="140" y="0" width="40" height="120" />
                      <rect class="dpf-mark" x="240" y="0" width="30" height="120" />
                    </svg>
                    <p class="dpf-axis mono" aria-hidden="true"><span>20:00</span><span>50 ms budget</span><span>21:00</span></p>
                    <figcaption class="dpf-insight">
                      <b>Generating new terrain is likely a big part of the load</b>
                      <span>Exploring players force the server to generate chunks while it ticks.</span>
                      <span class="dpf-fix mono">Open pre-generation <UiIcon name="arrow-right" size={12} /></span>
                    </figcaption>
                  </figure>
                )}
                {c.id === "assistant" && (
                  <div class="demo-ai" data-ai>
                    <p class="ai-row ai-user">Whitelist Steve, he joins tonight</p>
                    <p class="ai-row ai-tool mono"><UiIcon name="check" size={12} />List players on survival</p>
                    <p class="ai-row ai-bot">Alex and Sam are online and the whitelist is on. I'll add Steve.</p>
                    <div class="ai-row ai-card" data-ai-card>
                      <p class="ai-card-title">Add Steve to the whitelist</p>
                      <div class="ai-card-foot">
                        <span class="ai-state mono" aria-live="polite" data-ai-state>Waiting for your approval</span>
                        <button type="button" class="btn btn-small btn-outline" data-ai-act="decline">Decline</button>
                        <button type="button" class="btn btn-small btn-ink" data-ai-act="approve">Approve</button>
                        <button type="button" class="btn btn-small btn-outline" data-ai-act="reset" hidden>Ask again</button>
                      </div>
                    </div>
                    <p class="ai-console mono" data-ai-out hidden>[21:04:12 INFO]: Added Steve to the whitelist</p>
                  </div>
                )}
                {c.id === "security" && (
                  <ol class="hops">
                    {hops.map((h) => (
                      <li class="hop">
                        <p class="hop-name"><UiIcon name={h.icon} size={24} />{h.name}<span class="hop-where mono">{h.where}</span></p>
                        <ul class="hop-checks mono">{h.checks.map((k) => <li>{k}</li>)}</ul>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            </div>
            <dl class="cells specs">
              {c.specs.map(([k, v]) => (
                <div class="cell"><dt class="mono">{k}</dt><dd>{v}</dd></div>
              ))}
            </dl>
          </section>
        ))}
      </div>
    </div>

    <!-- The rest, as a dense grid -->
    <section class="row" aria-labelledby="more-title">
      <div class="cell row-head row-head-inline">
        <h2 id="more-title" class="display">Also in the box.</h2>
        <a class="mono" href="/docs/">All features in the docs <UiIcon name="arrow-right" size={12} /></a>
      </div>
      <ul class="cells extras">
        {extras.map((e) => (
          <li class="cell">
            <p class="extra-title"><UiIcon name={e.icon} size={24} />{e.title}</p>
            <p class="extra-text">{e.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Hardware -->
    <section class="row" id="hardware" aria-labelledby="hw-title">
      <div class="cell row-head">
        <p class="sec-no mono"><span>08</span>Hardware</p>
        <h2 id="hw-title" class="display">Runs on what you have.</h2>
        <p class="row-lead">Planning estimates for Paper with a pre-generated world. Mods, mob farms and view distance change the load.</p>
      </div>
      <div class="cells devices2">
        {devices.map((d) => (
          <a class="cell cell-vis device2" href={d.href}>
            <Iso boxes={d.scene} label={d.name} class="iso night" />
            <span class="device2-body">
              <span class="device2-name">{d.name} <UiIcon name="arrow-right" size={12} /></span>
              <span class="device2-os mono">{d.os}</span>
              <span class="device2-stats">
                <span><span class="mono">RAM for Minecraft</span><b>{d.ram}</b></span>
                <span><span class="mono">players, estimate</span><b>{d.players}</b></span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Comparison -->
    <section class="row" id="compare" aria-labelledby="compare-title">
      <div class="cell row-head">
        <p class="sec-no mono"><span>09</span>Hosting choices</p>
        <h2 id="compare-title" class="display">Run it yourself, <span class="dim">or rent a managed server?</span></h2>
        <p class="row-lead">Both are good answers; the question is who looks after the machine. If nobody wants to, rent one. If you run many machines or games, Pterodactyl or Crafty Controller fit better.</p>
      </div>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Self-hosting and managed Minecraft hosting comparison">
        <table class="compare">
          <thead>
            <tr><th scope="col"><span class="sr-only">Aspect</span></th><th scope="col" class="is-us">CraftPanel on your machine</th><th scope="col">Managed Minecraft hosting</th></tr>
          </thead>
          <tbody>
            {compare.map((r) => (
              <tr>
                <th scope="row" class="mono">{r.aspect}</th>
                {r.cells.map(([m, text], i) => (
                  <td class={i === 0 ? "is-us" : undefined} data-mark={m}>
                    <span class="cmp-col mono" aria-hidden="true">{i === 0 ? "CraftPanel" : "Managed"}</span>
                    <span class="cmp-cell"><span class="cmp-mark"><UiIcon name={marks[m].icon} size={12} label={marks[m].label} /></span>{text}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Project -->
    <section class="row" aria-labelledby="trust-title">
      <div class="cells project">
        <div class="cell">
          <p class="sec-no mono"><span>10</span>Project</p>
          <h2 id="trust-title" class="display">Built by Victor, <span class="dim">in the open.</span></h2>
          <div class="project-author">
            <a href="https://github.com/vctrchappot" rel="noopener">
              <Image src={avatar} alt="Victor Chappot, author of CraftPanel (GitHub profile)" width={48} height={48} class="avatar" />
            </a>
            <p><b>Victor</b><a href="https://github.com/vctrchappot" rel="noopener">@vctrchappot</a></p>
          </div>
        </div>
        <dl class="cell project-facts">
          <div><dt class="mono">latest release</dt><dd><a href={release.url}>{release.tag}</a>{releaseDate && <span class="dim"> · {releaseDate}</span>}</dd></div>
          <div><dt class="mono">tests</dt><dd>400+ automated, plus real servers joined by a bot</dd></div>
          <div><dt class="mono">ci</dt><dd>Linux, Windows, macOS and ARM64 on every push</dd></div>
          <div><dt class="mono">license</dt><dd><a href={`${github}/blob/main/LICENSE`}>FSL-1.1-ALv2</a>, Apache-2.0 after two years</dd></div>
          <div><dt class="mono">telemetry</dt><dd>None</dd></div>
          <div><dt class="mono">source</dt><dd><a href={github} rel="noopener">GitHub</a> · <a href={`${github}/issues`} rel="noopener">issues</a> · <a href={`${github}/blob/main/docs/ROADMAP.md`} rel="noopener">roadmap</a></dd></div>
        </dl>
      </div>
    </section>

    <div class="row row-faq">
      <FaqSection items={faqs} no="11" />
    </div>

    <!-- Install -->
    <section class="row" id="install" aria-labelledby="install-title">
      <div class="cells install2">
        <div class="cell">
          <p class="sec-no mono"><span>12</span>Install</p>
          <h2 id="install-title" class="display">One command, <span class="dim">then the browser.</span></h2>
          <ol class="install2-steps">
            <li><span class="mono">1</span>Run the command for your system.</li>
            <li><span class="mono">2</span>Open the address it prints, with the setup token.</li>
            <li><span class="mono">3</span>Create your first server.</li>
          </ol>
          <p class="install2-links"><a href="/docs/getting-started/installation/">Installation guide <UiIcon name="arrow-right" size={12} /></a><a href="/raspberry-pi/">On a Raspberry Pi <UiIcon name="arrow-right" size={12} /></a><a href="/windows/">On Windows <UiIcon name="arrow-right" size={12} /></a></p>
        </div>
        <div class="cell cell-term">
          <Terminal version={version} id="install-term" />
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
