---
import { Image } from "astro:assets";
import "../styles/fonts.css";
import "../styles/landing.css";
import Pixel from "../components/Pixel.astro";
import UiIcon from "../components/UiIcon.astro";
import type { PixelName } from "../lib/pixel-icons";
import type { UiIconName } from "../lib/ui-icons";
import Iso from "../components/Iso.astro";
import Terminal from "../components/Terminal.astro";
import RuntimeDiagram from "../components/RuntimeDiagram.astro";
import ProcessBand from "../components/ProcessBand.astro";
import Shot from "../components/Shot.astro";
import { heroScene, pcScene, piScene, vpsScene } from "../lib/scenes";
import { repoFacts, shownRelease } from "../lib/github";
// release.mjs bumps every workspace package, so this matches the latest release.
import pkg from "../../package.json";
import Mark from "../components/Mark.astro";
import avatar from "../assets/victor.jpg";

const facts = await repoFacts();
const version = pkg.version;
const release = shownRelease(facts.release, version);
const releaseDate = release.date ? new Date(release.date).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : "";
const github = "https://github.com/vctrchappot/CraftPanel";
const title = "CraftPanel – Your Minecraft server, on your hardware";
const description =
  "Self-hosted panel for Minecraft Java servers on a PC, a Raspberry Pi or a VPS. Paper, Purpur, Fabric, NeoForge, Vanilla and Velocity. No panel fee, no telemetry.";

const software = {
  paper: {
    key: "paper",
    name: "Paper",
    icon: "paper" as PixelName,
    color: "#e8e2d4",
    note: "Plugins, fast and Vanilla-like.",
    rec: true,
    title: "survival",
    versions: [
      ["1.21.4", "build 232"],
      ["1.21.3", "build 81"],
      ["1.20.6", "build 151"],
    ],
    java: "Java 21",
    tabs: ["Overview", "Console", "Players", "Plugins", "Backups", "Settings"],
    highlightTab: "Plugins",
    servers: [
      { name: "survival", status: "on" },
      { name: "lobby", status: "off" },
    ],
    players: "6 / 20",
    middleStat: ["TPS", "20.0"],
    memRatio: 0.7,
    sourceIcon: "plug" as const,
    source: "Plugins from Modrinth & Hangar",
  },
  purpur: {
    key: "purpur",
    name: "Purpur",
    icon: "purpur" as PixelName,
    color: "#b98ad0",
    note: "Paper with more settings.",
    rec: false,
    title: "survival",
    versions: [
      ["1.21.4", "build 2417"],
      ["1.21.3", "build 2385"],
      ["1.20.6", "build 2250"],
    ],
    java: "Java 21",
    tabs: ["Overview", "Console", "Players", "Plugins", "Backups", "Settings"],
    highlightTab: "Plugins",
    servers: [
      { name: "survival", status: "on" },
      { name: "lobby", status: "off" },
    ],
    players: "8 / 30",
    middleStat: ["TPS", "20.0"],
    memRatio: 0.7,
    sourceIcon: "plug" as const,
    source: "Plugins from Modrinth & Hangar",
  },
  fabric: {
    key: "fabric",
    name: "Fabric",
    icon: "fabric" as PixelName,
    color: "#d9b77e",
    note: "Light mods like Lithium.",
    rec: false,
    title: "survival",
    versions: [
      ["1.21.4", "loader 0.16.10"],
      ["1.21.3", "loader 0.16.9"],
      ["1.20.6", "loader 0.16.5"],
    ],
    java: "Java 21",
    tabs: ["Overview", "Console", "Players", "Mods", "Backups", "Settings"],
    highlightTab: "Mods",
    servers: [
      { name: "survival", status: "on" },
      { name: "lobby", status: "off" },
    ],
    players: "4 / 20",
    middleStat: ["TPS", "20.0"],
    memRatio: 0.7,
    sourceIcon: "mod" as const,
    source: "Mods from Modrinth",
  },
  neoforge: {
    key: "neoforge",
    name: "NeoForge",
    icon: "neoforge" as PixelName,
    color: "#f08a24",
    note: "Big mods and modpacks.",
    rec: false,
    title: "modpack",
    versions: [
      ["1.21.4", "21.4.80"],
      ["1.21.3", "21.3.60"],
      ["1.20.6", "20.6.119"],
    ],
    java: "Java 21",
    tabs: ["Overview", "Console", "Players", "Mods", "Backups", "Settings"],
    highlightTab: "Mods",
    servers: [
      { name: "modpack", status: "on" },
      { name: "lobby", status: "off" },
    ],
    players: "3 / 10",
    middleStat: ["TPS", "20.0"],
    memRatio: 0.7,
    sourceIcon: "mod" as const,
    source: "Mods and modpacks from Modrinth",
  },
  vanilla: {
    key: "vanilla",
    name: "Vanilla",
    icon: "vanilla" as PixelName,
    color: "var(--cp-signal)",
    note: "Mojang's server, untouched.",
    rec: false,
    title: "survival",
    versions: [
      ["1.21.4", ""],
      ["1.21.3", ""],
      ["1.20.6", ""],
    ],
    java: "Java 21",
    tabs: ["Overview", "Console", "Players", "Backups", "Settings"],
    highlightTab: null,
    servers: [
      { name: "survival", status: "on" },
      { name: "lobby", status: "off" },
    ],
    players: "5 / 20",
    middleStat: ["TPS", "20.0"],
    memRatio: 0.7,
    sourceIcon: "cube" as const,
    source: "No add-ons. Straight from Mojang.",
  },
  velocity: {
    key: "velocity",
    name: "Velocity",
    icon: "velocity" as PixelName,
    color: "#3fb8e8",
    note: "Several servers, one address.",
    rec: false,
    title: "network",
    versions: [
      ["3.4.0", "build 4"],
      ["3.3.0", "build 410"],
      ["3.2.0", "build 296"],
    ],
    java: "Java 21",
    tabs: ["Overview", "Console", "Servers", "Plugins", "Settings"],
    highlightTab: "Plugins",
    servers: [
      { name: "network", status: "on" },
      { name: "survival", status: "up" },
      { name: "lobby", status: "up" },
    ],
    players: "14 / 100",
    middleStat: ["Servers", "3 / 3"],
    memRatio: 0.25,
    sourceIcon: "plug" as const,
    source: "Plugins from Hangar",
  },
} as const;

const softwareGroups: { label: string; wide: boolean; items: (keyof typeof software)[] }[] = [
  { label: "Plugin servers", wide: true, items: ["paper", "purpur"] },
  { label: "Mod loaders", wide: true, items: ["fabric", "neoforge"] },
  { label: "Unmodified", wide: false, items: ["vanilla"] },
  { label: "Proxy", wide: false, items: ["velocity"] },
];

const memoryOptions = [1, 2, 4, 8] as const;
const defaultSw = software.paper;
const defaultVer = defaultSw.versions[0];
const defaultMem = 2;
const defaultMeta = [`${defaultSw.name} ${defaultVer[0]}`, defaultVer[1], defaultSw.java].filter(Boolean).join(" · ");
const defaultMemText = `${(defaultMem * defaultSw.memRatio).toFixed(1)} / ${defaultMem.toFixed(1)}`;

const softwareTrust: { icon: UiIconName; title: string; text: string }[] = [
  { icon: "seal", title: "Official source", text: "Every server comes straight from the project that makes it." },
  { icon: "hash", title: "Checksum checked", text: "The download is verified before anything starts." },
  { icon: "cup", title: "Right Java, automatically", text: "CraftPanel installs the Java version your server needs." },
];

const minor: { title: string; icon: UiIconName; text: string }[] = [
  { title: "Teams and permissions", icon: "users", text: "Owner, Administrator, Operator or Viewer per server, with two-factor sign-in and an audit log." },
  { title: "Java, handled", icon: "cup", text: "1.8.9 gets Java 8, 1.21.4 gets 21, 26.3 gets 25. Downloaded per server, nothing to install." },
  { title: "Scheduled tasks", icon: "clock", text: "<code>0 4 * * *</code> restarts with a 60-second warning in chat. Backups, announcements and commands too." },
  { title: "Crash alerts", icon: "bell", text: "Discord or e-mail when a server crashes, a backup fails or a new release is out." },
  { title: "Network tools", icon: "signal", text: "Copyable LAN and VPN addresses, port checks, CGNAT detection and DuckDNS." },
  { title: "Files and worlds", icon: "folder", text: "Edit configs in the browser. Upload a world as a zip, or download one for single player." },
];

const looks = [
  {
    key: "overview",
    label: "Overview",
    alt: "Server overview with players, CPU, memory, TPS, uptime, storage, the last console lines and connection addresses",
    spots: [
      { x: 31, y: 27, text: "Players, CPU, memory, TPS, uptime and disk, refreshed live." },
      { x: 38, y: 60, text: "The newest console lines, without opening the console." },
      { x: 79, y: 47, text: "Addresses to copy for this computer, your LAN and your VPN." },
      { x: 86, y: 5.5, text: "Start, stop, restart. Force-kill is for Administrators only." },
    ],
  },
  {
    key: "console",
    label: "Console",
    alt: "Live Minecraft console with a filter, level selector and command input",
    spots: [
      { x: 42, y: 21.7, text: "Filter by text or log level. Download or copy the log." },
      { x: 27, y: 27, text: "Live. After a dashboard restart it reconnects and replays what you missed." },
      { x: 46, y: 92, text: "Commands go to Minecraft only, never to a shell. ↑ and ↓ browse history." },
    ],
  },
  {
    key: "plugins",
    label: "Plugins",
    alt: "Plugin browser with Modrinth results marked as compatible with Minecraft 1.21.4",
    spots: [
      { x: 60, y: 25, text: "Plugins are code. CraftPanel says so, every time." },
      { x: 25, y: 46.5, text: "Switch between Modrinth and Hangar." },
      { x: 35.4, y: 53, text: "Checked against your exact Minecraft version before you install." },
      { x: 93, y: 54, text: "One click. The download is verified against its checksum." },
    ],
  },
  {
    key: "servers",
    label: "All servers",
    alt: "Server list with a running Paper server and a stopped Fabric server",
    spots: [
      { x: 34, y: 19, text: "Status at a glance: running, stopped, starting, crashed." },
      { x: 92.7, y: 7.8, text: "The eight-step wizard: software, version, world, memory, network." },
      { x: 9, y: 36.5, text: "Every server one click away, with its player count." },
    ],
  },
] as const;

const devices = [
  { name: "The PC under your desk", os: "Windows · Linux · macOS", scene: pcScene(), ram: "4–8 GB", players: "10–30", note: "Automatic services on Windows and Linux; manual setup on macOS. Your gaming PC works too: Minecraft servers don't use the GPU." },
  { name: "Raspberry Pi 4 / 5", os: "64-bit Raspberry Pi OS", scene: piScene(), ram: "2–3 GB", players: "2–8", note: "Draws a few watts. Pick the Pi preset, pre-generate the world, keep worlds on an SSD." },
  { name: "A small VPS", os: "Linux with systemd", scene: vpsScene(), ram: "4–8 GB", players: "10–20", note: "Choose a plan with a public IP and allow the Minecraft port in its firewall. Keep the dashboard behind a VPN, SSH tunnel or HTTPS reverse proxy." },
];

const compare = {
  cols: ["CraftPanel", "Managed Minecraft hosting"],
  rows: [
    ["Where it runs", "A PC, Pi or VPS you control", "Infrastructure operated by your provider"],
    ["Getting started", "Linux/Windows installer; manual macOS setup", "Create an account and choose a plan"],
    ["Software", "Paper, Purpur, Fabric, NeoForge, Vanilla or Velocity", "Software and versions offered by the provider"],
    ["Worlds & files", "On your host, with direct file access", "On the provider's host; access depends on the plan"],
    ["Maintenance", "You manage the machine, network and backups", "Responsibilities depend on the provider and plan"],
    ["Costs", "Free panel; hardware, power and any VPS/network costs are yours", "Recurring hosting charge; pricing depends on the plan"],
  ],
};

const faqs = [
  { q: "What does it cost?", a: "The CraftPanel software is free. You pay for hardware, electricity and any VPS or connectivity you use. It is source-available under FSL-1.1-ALv2, which restricts competing commercial uses. Each version becomes Apache-2.0 after two years." },
  { q: "What hardware do I need?", a: "Anything that runs Node.js 22.13 or newer: a Windows or Linux PC, a Mac, a Raspberry Pi 4/5 with a 64-bit OS, or a small VPS. Minecraft needs most of the memory: about 2 GB for a small Paper server, 4 GB or more for modpacks." },
  { q: "Bedrock?", a: "Not yet. CraftPanel runs Minecraft Java Edition servers. A Bedrock adapter is on the roadmap." },
  { q: "Can I bring my existing world?", a: "Yes. Create a server with the same software and version, then import the world as a zip in the Worlds tab, or upload files in the file manager." },
  { q: "Should I open the dashboard to the internet?", a: "No. Only the Minecraft port should be public. Reach the dashboard through a VPN like Tailscale, an SSH tunnel or an HTTPS reverse proxy. By default CraftPanel only lets in private networks and refuses public clients without HTTPS." },
  { q: "Does it phone home?", a: "No telemetry and no CraftPanel cloud account. You create local users on your installation. CraftPanel goes online for official downloads, Modrinth and Hangar when you browse add-ons, and an optional update check against GitHub." },
];

const backups = [
  { when: "Today 04:00", size: "1.24 GB", tag: "nightly" },
  { when: "Yesterday 04:00", size: "1.23 GB", tag: "nightly" },
  { when: "Sun 03:00", size: "1.20 GB", tag: "weekly" },
  { when: "Before 1.21.4", size: "1.18 GB", tag: "manual" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://craftpanel.vctr.site/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://craftpanel.vctr.site/" />
    <meta property="og:image" content="https://craftpanel.vctr.site/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#171614" />
    <script is:inline>
      // Same storage key as Starlight, so the docs and this page share the theme choice.
      (() => {
        let stored = "";
        try { stored = localStorage.getItem("starlight-theme") || ""; } catch {}
        const theme = stored === "light" || stored === "dark" ? stored : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-in">
        <a href="/" class="brand"><Mark size={30} /><span>CraftPanel</span></a>
        <nav aria-label="Main" class="nav-links">
          <a href="#install">Install</a>
          <a href="#features">Features</a>
          <a href="#compare">Compare</a>
          <a href="/docs/">Docs</a>
        </nav>
        <div class="nav-end">
          <a class="nav-gh" href={github}>
            <UiIcon name="github" size={24} />
            <span class="hide-sm">GitHub</span>
            {facts.stars !== null && facts.stars >= 10 && <span class="nav-stars"><UiIcon name="star" size={12} />{facts.stars}</span>}
          </a>
          <button class="nav-theme" id="theme-toggle" type="button" aria-label="Switch between dark and light mode">
            <UiIcon name="sun" size={24} class="if-dark" />
            <UiIcon name="moon" size={24} class="if-light" />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero" id="install" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="hero-kicker mono"><span class="px-dot" aria-hidden="true"></span><a href={release.url}>{release.tag}</a> · self-hosted Minecraft panel</p>
            <h1 id="hero-title" class="display">Your server.<br />Your hardware.<br /><span class="mark">No panel fee.</span></h1>
            <p class="hero-lead">
              Run Minecraft Java servers on your PC, Raspberry Pi or VPS. Manage them from your browser.
            </p>
            <Terminal version={version} id="hero-term" />
            <div class="install-help">
              <a href="/docs/getting-started/installation/">Installation guide <span aria-hidden="true">↗</span></a>
              <a href="/docs/getting-started/installation/#macos">macOS: manual setup <span aria-hidden="true">↗</span></a>
            </div>
            <ul class="hero-facts mono" aria-label="Supported platforms">
              <li>Windows · Linux · macOS</li>
              <li>x64 · ARM64 · Raspberry Pi</li>
              <li>No Docker, no Java setup</li>
            </ul>
          </div>
          <div class="hero-art" aria-hidden="false">
            <div class="hero-scene">
              <Iso boxes={heroScene()} label="A Raspberry Pi with a small Minecraft world floating above it" class="iso hero-iso" />
              <div class="hero-chip mono" aria-hidden="true">
                <span class="chip-row"><span class="dot-run"></span>survival</span>
                <span class="chip-row muted">Paper 1.21.4</span>
                <span class="chip-row"><b>6</b>/20 online · TPS <b>20.0</b></span>
              </div>
            </div>
            <p class="hero-host mono" aria-hidden="true">raspberrypi.local · 4 GB</p>
          </div>
        </div>
      </section>

      <!-- From install to update -->
      <section class="sec-band" aria-labelledby="band-title">
        <div class="wrap">
          <h2 id="band-title" class="sr-only">From install to update</h2>
          <ProcessBand />
        </div>
      </section>

      <hr class="px-rule" />

      <!-- 01 Server software -->
      <section class="sec" aria-labelledby="types-title" data-types data-software={JSON.stringify(software)}>
        <div class="wrap">
          <header class="sec-head">
            <p class="sec-no mono"><span>01</span>Server software</p>
            <h2 id="types-title" class="display">Six kinds of server. One wizard.</h2>
            <p class="sec-lead">Pick the software, the version and the memory. CraftPanel does the rest and shows you what you'll get.</p>
          </header>

          <div class="types">
            <div class="type-groups" role="radiogroup" aria-label="Server software">
              {
                softwareGroups.map((group) => (
                  <div class:list={["type-group", { "is-wide": group.wide }]}>
                    <p class="type-group-label">{group.label}</p>
                    <div class="type-cards">
                      {group.items.map((key) => {
                        const t = software[key];
                        return (
                          <label class:list={["type", { "has-badge": t.rec }]} style={`--type:${t.color}`}>
                            <input type="radio" name="sw" value={t.key} checked={t.key === "paper"} />
                            <span class="type-body">
                              <span class="type-icon"><Pixel name={t.icon} size={32} /></span>
                              <span class="type-text">
                                <span class="type-name">
                                  {t.name}
                                  {t.rec && <span class="type-rec mono">Recommended</span>}
                                </span>
                                <span class="type-note">{t.note}</span>
                              </span>
                            </span>
                            <span class="type-check" aria-hidden="true"><UiIcon name="check" size={12} /></span>
                          </label>
                        );
                      })}
                    </div>
                  </div>
                ))
              }
            </div>

            <div class="preview-col">
              <div class="pv-cap mono">
                <span>Your panel</span>
                <span data-pv="cap">{defaultSw.name} {defaultVer[0]} selected</span>
              </div>
              <div class="preview" style={`--type:${defaultSw.color}`}>
                <div class="pv-bar">
                  <span class="pv-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="mono">localhost:8080/server</span>
                </div>
                <div class="pv-body">
                  <aside class="pv-side" aria-hidden="true">
                    <span class="pv-brand"><Mark size={20} />CraftPanel</span>
                    <span class="pv-side-label mono">Servers</span>
                    <div class="pv-side-list" data-pv="servers">
                      {
                        defaultSw.servers.map((srv) => (
                          <span class:list={["pv-side-item", `is-${srv.status}`]}>
                            <span class="pv-srv-dot"></span>
                            <span>{srv.name}</span>
                          </span>
                        ))
                      }
                    </div>
                  </aside>
                  <div class="pv-main" aria-live="polite">
                    <div class="pv-head">
                      <span class="pv-name" data-pv="title">{defaultSw.title}</span>
                      <span class="pv-status"><span class="dot-run"></span>Running</span>
                      <span class="pv-badge" data-pv="name">{defaultSw.name}</span>
                    </div>
                    <p class="pv-meta mono" data-pv="meta">{defaultMeta}</p>
                    <div class="pv-tabs" aria-hidden="true" data-pv="tabs">
                      {
                        defaultSw.tabs.map((tab, idx) => (
                          <span class:list={["pv-tab", { "is-on": idx === 0, "is-new": tab === defaultSw.highlightTab }]}>{tab}</span>
                        ))
                      }
                    </div>
                    <dl class="pv-stats" data-pv="stats">
                      <div><dt>Players</dt><dd class="mono" data-pv="players">{defaultSw.players}</dd></div>
                      <div><dt data-pv="mid-label">{defaultSw.middleStat[0]}</dt><dd class="mono" data-pv="mid-val">{defaultSw.middleStat[1]}</dd></div>
                      <div><dt>Memory</dt><dd class="mono" data-pv="mem"><span>{defaultMemText}</span><small>GB</small></dd></div>
                    </dl>
                    <div class="pv-addons" data-pv="source-wrap">
                      <span class="pv-source-icon" data-source-icon="plug"><UiIcon name="plug" size={24} /></span>
                      <span class="pv-source-icon" data-source-icon="mod" hidden><UiIcon name="mod" size={24} /></span>
                      <span class="pv-source-icon" data-source-icon="cube" hidden><UiIcon name="box" size={24} /></span>
                      <span data-pv="addons">{defaultSw.source}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="wizard" aria-label="Your server setup">
            <div class="wz-step">
              <div class="wz-step-head"><b class="mono">1</b><span>Software</span></div>
              <div class="wz-step-val">
                {
                  Object.values(software).map((s) => (
                    <span class="type-icon wz-sw-icon" data-wz-icon={s.key} style={`--type:${s.color}`} hidden={s.key !== "paper"}>
                      <Pixel name={s.icon} size={32} />
                    </span>
                  ))
                }
                <span data-wz="sw-name">{defaultSw.name}</span>
              </div>
            </div>
            <div class="wz-step">
              <div class="wz-step-head"><b class="mono">2</b><label for="wz-ver">Version</label></div>
              <div class="wz-select">
                <select id="wz-ver" data-wz-ver>
                  {defaultSw.versions.map((v, idx) => <option value={String(idx)} selected={idx === 0}>{v[0]}</option>)}
                </select>
              </div>
            </div>
            <div class="wz-step">
              <div class="wz-step-head"><b class="mono">3</b><span>Memory</span></div>
              <div class="wz-step-val">
                <div class="wz-seg" role="radiogroup" aria-label="Memory in gigabytes" data-wz-mem>
                  {
                    memoryOptions.map((m) => (
                      <label>
                        <input type="radio" name="wz-mem" value={String(m)} checked={m === defaultMem} aria-label={`${m} gigabytes`} />
                        <span class="mono">{m}</span>
                      </label>
                    ))
                  }
                </div>
                <span class="wz-unit">GB</span>
              </div>
            </div>
            <div class="wz-cta-wrap">
              <button class="wz-btn" type="button" data-wz-cta>Create a {defaultSw.name} server</button>
              <a class="wz-link" href="/docs/guides/server-software/">See all supported versions</a>
            </div>
          </div>

          <div class="sw-trust">
            {
              softwareTrust.map((item) => (
                <div class="sw-trust-item">
                  <span class="sw-trust-icon"><UiIcon name={item.icon} size={24} /></span>
                  <div>
                    <strong>{item.title}</strong>
                    <p>{item.text}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 02 Features -->
      <section class="sec sec-dense" id="features" aria-labelledby="features-title">
        <div class="wrap">
          <header class="sec-head">
            <p class="sec-no mono"><span>02</span>What it does</p>
            <h2 id="features-title" class="display">The stuff you'd otherwise do over SSH at 23:00.</h2>
          </header>

          <div class="bento">
            <article class="tile tile-console">
              <div class="tile-copy">
                <p class="tile-label mono"><UiIcon name="terminal" size={24} />live console · metrics</p>
                <h3>See what your server is doing. Right now.</h3>
                <p>The real console over WebSockets, with history, filters and command input. Players, CPU, memory and TPS update every few seconds.</p>
              </div>
              <div class="demo-console" data-console>
                <div class="dc-metrics mono" aria-hidden="true">
                  <span>players <b data-m="players">2</b>/20</span>
                  <span>tps <b data-m="tps">20.0</b></span>
                  <span>cpu <b data-m="cpu">12</b>%</span>
                  <span class="dc-spark" data-spark>{Array.from({ length: 24 }, (_, i) => <i style={`--v:${(30 + ((i * 37) % 50))}%`}></i>)}</span>
                </div>
                <ol class="dc-log mono" aria-label="Example console output">
                  <li>[19:57:51 INFO]: Starting minecraft server version 1.21.4</li>
                  <li>[19:57:52 INFO]: Loading properties</li>
                  <li>[19:57:55 INFO]: Preparing level "world"</li>
                  <li>[19:57:58 INFO]: Preparing start region for dimension minecraft:overworld</li>
                  <li>[19:58:02 INFO]: Done (8.412s)! For help, type "help"</li>
                  <li>[19:58:41 INFO]: UUID of player Alex is 8667ba71-b85a-4004-af54-457a9734eed7</li>
                  <li>[19:58:41 INFO]: Alex joined the game</li>
                  <li>[19:59:07 INFO]: &lt;Alex&gt; anyone up for the nether?</li>
                  <li>[20:00:12 INFO]: UUID of player Sam is 0ba1d6e5-61c4-4f7f-9b2c-3f2a6d1c88a0</li>
                  <li>[20:00:12 INFO]: Sam joined the game</li>
                  <li class="dc-warn">[20:00:30 WARN]: Can't keep up! Is the server overloaded? Running 2154ms behind, skipping 43 ticks</li>
                  <li>[20:02:18 INFO]: UUID of player Mia is c4f8a2b0-9d3e-4c71-8a65-1e7b0d2f4a93</li>
                  <li>[20:02:18 INFO]: Mia joined the game</li>
                  <li>[20:02:55 INFO]: &lt;Sam&gt; yes, after the cave</li>
                  <li>[20:03:41 INFO]: Mia left the game</li>
                  <li class="dc-cmd">&gt; say Nether trip at 9. Bring food.</li>
                  <li>[20:04:02 INFO]: [Server] Nether trip at 9. Bring food.</li>
                  <li>[20:15:00 INFO]: Saving the game (this may take a moment!)</li>
                  <li>[20:15:00 INFO]: Saved the game</li>
                  <li>[20:21:37 INFO]: Sam has made the advancement [Hot Stuff]</li>
                  <li>[20:24:09 INFO]: &lt;Alex&gt; see you at 9</li>
                </ol>
                <div class="dc-input mono" aria-hidden="true"><span>&gt;</span><span class="dc-typed">say hello</span></div>
              </div>
            </article>

            <article class="tile tile-update">
              <div class="tile-copy">
                <p class="tile-label mono"><UiIcon name="upload" size={24} />independent runtime</p>
                <h3>Update the panel. Keep playing.</h3>
                <p>Minecraft runs in its own service. Watch the dashboard update and reconnect while your worlds keep ticking.</p>
              </div>
              <RuntimeDiagram />
            </article>

            <article class="tile tile-backup">
              <div class="tile-copy">
                <p class="tile-label mono"><UiIcon name="archive" size={24} />backups</p>
                <h3>23:04. Someone TNT'd the base.</h3>
                <p>Pick last night's backup and press Restore. CraftPanel verifies the archive and saves the current mess first, just in case.</p>
              </div>
              <div class="demo-backup" data-backup>
                <fieldset class="db-list">
                  <legend class="sr-only">Backups of survival</legend>
                  {
                    backups.map((b, i) => (
                      <label class="db-item">
                        <input type="radio" name="backup" value={b.when} checked={i === 1} />
                        <span class="db-when">{b.when}</span>
                        <span class="db-size mono">{b.size}</span>
                        <span class="db-tag mono">{b.tag} · verified</span>
                      </label>
                    ))
                  }
                </fieldset>
                <div class="db-foot">
                  <button type="button" class="btn btn-small btn-ink" data-restore>Restore</button>
                  <ol class="db-steps mono" aria-live="polite" data-steps></ol>
                </div>
              </div>
            </article>

            <article class="tile tile-plugins">
              <div class="tile-copy">
                <p class="tile-label mono"><UiIcon name="blocks" size={24} />plugins · mods · modpacks</p>
                <h3>Modrinth and Hangar, built in.</h3>
                <p>Search, install with checksum checks and get update suggestions. Or start from a Modrinth modpack: the Minecraft and loader version come from the pack.</p>
              </div>
              <div class="demo-search">
                <p class="dp-field mono" aria-label="Example search for luck"><UiIcon name="search" size={12} /><span class="dp-query">luck</span><span class="dp-count">3 results · Paper 1.21.4</span></p>
                <ul class="demo-plugins" aria-label="Example search results">
                  <li><span class="dp-name">LuckPerms</span><span class="dp-ok mono">supports 1.21.4</span><span class="dp-src mono">Modrinth</span></li>
                  <li><span class="dp-name">LuckPerms</span><span class="dp-ok mono">supports 1.21.4</span><span class="dp-src mono">Hangar</span></li>
                  <li><span class="dp-name">Lucky Block</span><span class="dp-warn mono">needs Fabric</span><span class="dp-src mono">Modrinth</span></li>
                </ul>
                <p class="dp-note">Same plugin, two sources. CraftPanel picks the one that fits your version.</p>
              </div>
            </article>

            <article class="tile tile-list">
              <ul class="minor">
                {
                  minor.map((m) => (
                    <li>
                      <h3 class="minor-title"><UiIcon name={m.icon} size={24} />{m.title}</h3>
                      <p class="minor-text" set:html={m.text} />
                    </li>
                  ))
                }
              </ul>
            </article>
          </div>
        </div>
      </section>

      <!-- 03 Closer look -->
      <section class="sec" aria-labelledby="look-title">
        <div class="wrap">
          <header class="sec-head sec-head-row">
            <div>
              <p class="sec-no mono"><span>03</span>Inside the dashboard</p>
              <h2 id="look-title" class="display">Inside CraftPanel.</h2>
            </div>
            <div class="look-tabs" role="tablist" aria-label="Dashboard screens" data-look-tabs>
              {
                looks.map((l, i) => (
                  <button role="tab" type="button" id={`look-tab-${l.key}`} aria-controls={`look-${l.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                    {l.label}
                  </button>
                ))
              }
            </div>
          </header>
          <div class="look">
            <div class="window">
              <div class="window-bar" aria-hidden="true"><span class="pv-dots"><i></i><i></i><i></i></span><span class="mono">craftpanel · localhost:8080</span></div>
              <div class="look-stage">
                {
                  looks.map((l, i) => (
                    <div class="look-panel" role="tabpanel" id={`look-${l.key}`} aria-labelledby={`look-tab-${l.key}`} data-active={i === 0 ? "true" : "false"} inert={i !== 0}>
                      <Shot name={l.key} alt={l.alt} eager={i === 0} />
                      {l.spots.map((s, n) => (
                        <button type="button" class="spot" style={`left:${s.x}%;top:${s.y}%`} aria-describedby={`spot-${l.key}-${n}`} data-spot={`${l.key}-${n}`}>
                          <span class="spot-n mono">{n + 1}</span>
                          <span class="spot-tip" role="tooltip" id={`spot-${l.key}-${n}`}>{s.text}</span>
                        </button>
                      ))}
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="look-legend">
              {
                looks.map((l, i) => (
                  <ol class="legend mono" data-legend={l.key} hidden={i !== 0}>
                    {l.spots.map((s, n) => (
                      <li data-spot-ref={`${l.key}-${n}`}>
                        <span class="legend-n">{n + 1}</span>
                        <span>{s.text}</span>
                      </li>
                    ))}
                  </ol>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- 04 Hardware -->
      <section class="sec sec-stone" aria-labelledby="hw-title">
        <div class="wrap">
          <header class="sec-head">
            <p class="sec-no mono"><span>04</span>Hardware</p>
            <h2 id="hw-title" class="display">Runs on what you have.</h2>
            <p class="sec-lead">Planning estimates for Paper with a pre-generated world, not measured hardware benchmarks. Mods, mob farms and view distance change the load.</p>
          </header>
          <div class="devices">
            {
              devices.map((d) => (
                <article class="device">
                  <div class="device-art">
                    <Iso boxes={d.scene} label={d.name} class="iso" />
                  </div>
                  <h3>{d.name}</h3>
                  <p class="device-os mono">{d.os}</p>
                  <dl class="device-stats">
                    <div><dt class="mono">RAM for Minecraft</dt><dd class="display">{d.ram}</dd></div>
                    <div><dt class="mono">Players, estimate</dt><dd class="display">{d.players}</dd></div>
                  </dl>
                  <p class="device-note">{d.note}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 05 Comparison -->
      <section class="sec" id="compare" aria-labelledby="compare-title">
        <div class="wrap wrap-mid">
          <header class="sec-head">
            <p class="sec-no mono"><span>05</span>Hosting choices</p>
            <h2 id="compare-title" class="display">Run it yourself, or rent a managed server?</h2>
            <p class="sec-lead">CraftPanel manages Minecraft on one host you control. A managed host takes on some of that work. Choose based on who should look after the machine, not just the price of the panel.</p>
          </header>
          <div class="table-scroll" tabindex="0" role="region" aria-label="Self-hosting and managed Minecraft hosting comparison">
            <table class="compare">
              <thead>
                <tr><th scope="col"><span class="sr-only">Aspect</span></th>{compare.cols.map((c, i) => <th scope="col" class={i === 0 ? "is-us" : undefined}>{c}</th>)}</tr>
              </thead>
              <tbody>
                {compare.rows.map(([label, ...cells]) => (
                  <tr>
                    <th scope="row" class="mono">{label}</th>
                    {cells.map((c, i) => <td class={i === 0 ? "is-us" : undefined} data-label={compare.cols[i]}>{c}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="comparison-note">CraftPanel is free. Hardware, electricity and any VPS or connectivity costs are yours. Managed hosting varies by provider and plan.</p>
          <p class="fineprint">Looking at other self-hosted panels? Pterodactyl and Crafty Controller are alternatives. CraftPanel currently manages one host; multiple hosts are planned.</p>
        </div>
      </section>

      <!-- 06 Trust -->
      <section class="sec sec-trust" aria-labelledby="trust-title">
        <div class="wrap trust">
          <div class="trust-project">
            <p class="sec-no mono"><span>06</span>Project & source</p>
            <h2 id="trust-title" class="display">Built by Victor.</h2>
            <p>CraftPanel is built for people running their own Minecraft server. The source, issues and release notes are public.</p>
            <a class="trust-cta" href={github} rel="noopener">
              <UiIcon name="github" size={24} /> View on GitHub
              {facts.stars !== null && facts.stars >= 10 && <span class="trust-cta-count">{facts.stars} stars</span>}
            </a>
            <div class="project-author">
              <a class="avatar-link" href="https://github.com/vctrchappot" rel="noopener">
                <Image src={avatar} alt="Victor Chappot, author of CraftPanel (GitHub profile)" width={48} height={48} class="avatar" />
              </a>
              <div>
                <p class="author-name">Victor</p>
                <a class="author-handle" href="https://github.com/vctrchappot" rel="noopener">@vctrchappot</a>
              </div>
            </div>
          </div>
          <dl class="trust-facts">
            <div>
              <dt class="mono">latest release</dt>
              <dd>
                <span class="fact-badge mono">{release.tag}</span>{releaseDate && <span class="muted"> {releaseDate}</span>} · <a href={release.url}>Release notes</a>
              </dd>
            </div>
            <div><dt class="mono">tests</dt><dd>260+ automated tests, plus real-server scenarios with a bot that joins and chats</dd></div>
            <div><dt class="mono">ci</dt><dd>Every push: Linux, Windows, macOS and ARM64</dd></div>
            <div><dt class="mono">license</dt><dd><a href={`${github}/blob/main/LICENSE`}>FSL-1.1-ALv2</a>, Apache-2.0 after two years</dd></div>
            <div><dt class="mono">telemetry</dt><dd><span class="fact-none"><UiIcon name="check" size={12} /><strong>None.</strong></span> Not even a counter.</dd></div>
            <div><dt class="mono">github</dt><dd><a href={github} rel="noopener">Source</a>, <a href={`${github}/issues`} rel="noopener">issues</a> and <a href={`${github}/blob/main/docs/ROADMAP.md`} rel="noopener">roadmap</a>. A star helps.</dd></div>
          </dl>
        </div>
      </section>

      <!-- 07 FAQ -->
      <section class="sec" aria-labelledby="faq-title">
        <div class="wrap wrap-narrow">
          <header class="sec-head">
            <p class="sec-no mono"><span>07</span>Questions</p>
            <h2 id="faq-title" class="display">Asked before.</h2>
          </header>
          <div class="faq">
            {
              faqs.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta" aria-labelledby="cta-title">
        <div class="wrap cta-in">
          <div>
            <h2 id="cta-title" class="display">Install CraftPanel.</h2>
            <ol class="cta-steps">
              <li><span class="cta-step-no mono" aria-hidden="true">1</span>Run the command</li>
              <li><span class="cta-step-no mono" aria-hidden="true">2</span>Open <span class="mono">localhost:8080</span></li>
              <li><span class="cta-step-no mono" aria-hidden="true">3</span>Create your first server</li>
            </ol>
            <div class="cta-links">
              <a class="cta-btn cta-btn-primary" href="/docs/getting-started/installation/">Installation guide <UiIcon name="arrow-right" size={12} /></a>
              <a class="cta-btn cta-btn-secondary" href={github} rel="noopener"><UiIcon name="github" size={24} /> View on GitHub</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
          <Terminal version={version} id="cta-term" compact />
        <div class="foot-brand">
          <a href="/" class="brand"><Mark size={26} /><span>CraftPanel</span></a>
          <p>Built for people who'd rather play than configure. Made by <a href="https://www.vctr.site">Victor</a>.</p>
        </div>
        <nav class="foot-cols" aria-label="Footer">
          <div>
            <h4 class="mono">product</h4>
            <a href="#features">Features</a>
            <a href="/docs/getting-started/installation/">Install</a>
            <a href={`${github}/releases`}>Releases</a>
            <a href={`${github}/blob/main/CHANGELOG.md`}>Changelog</a>
          </div>
          <div>
            <h4 class="mono">docs</h4>
            <a href="/docs/">Introduction</a>
            <a href="/docs/getting-started/first-server/">First server</a>
            <a href="/docs/administration/remote-access/">Remote access</a>
            <a href="/docs/reference/troubleshooting/">Troubleshooting</a>
          </div>
          <div>
            <h4 class="mono">project</h4>
            <a href={github}>GitHub</a>
            <a href={`${github}/issues`}>Issues</a>
            <a href="/docs/reference/security/">Security</a>
            <a href={`${github}/blob/main/LICENSE`}>License</a>
          </div>
        </nav>
      </div>
      <div class="wrap">
        <form class="foot-console mono" data-foot-console autocomplete="off">
          <ol class="fc-out" aria-live="polite" data-fc-out>
            <li class="fc-dim">[Server] This footer has a console. Type help.</li>
          </ol>
          <label class="fc-in">
            <span aria-hidden="true">&gt;</span>
            <span class="sr-only">Footer console command</span>
            <input name="cmd" type="text" spellcheck="false" placeholder="help" maxlength="60" />
          </label>
        </form>
        <p class="foot-legal">Minecraft is a trademark of Mojang AB. CraftPanel is not affiliated with Mojang or Microsoft and never redistributes server software.</p>
      </div>
    </footer>

    <script src="../scripts/landing.ts"></script>
  </body>
</html>
