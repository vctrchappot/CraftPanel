---
// Software icons: hand-drawn on a 16x16 grid with a 1 px outline, used at integer scales (32 px = 2x, 48 px = 3x).
// o = outline (fixed dark ink), a/b = the two fills, h = highlight. Colours come from --px-a/--px-b/--px-h, which
// the cards derive from the software colour. UI icons live in UiIcon.astro.
import { pixelIcons, type PixelName } from "../lib/pixel-icons";

interface Props {
  name: PixelName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 32, class: className, label } = Astro.props;
const rows = pixelIcons[name];
// Merge horizontal runs of the same colour into one rect.
const rects: { x: number; y: number; w: number; k: string }[] = [];
rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const k = row[x];
    if (k === ".") {
      x++;
      continue;
    }
    let end = x;
    while (end < row.length && row[end] === k) end++;
    rects.push({ x, y, w: end - x, k });
    x = end;
  }
});
---

<svg
  class:list={["px-icon", `px-i-${name}`, className]}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  shape-rendering="crispEdges"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
>
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" class={`px-${r.k}`} />)}
</svg>
