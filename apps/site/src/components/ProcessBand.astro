---
import Iso from "./Iso.astro";
import { processScenes } from "../lib/scenes";

// Seven real steps, from the install command to a panel update, threaded on one line from your browser to
// your players. "who" says who does the step: three are yours, the rest CraftPanel (or the players) does.
// Captions are values CraftPanel actually shows; notes repeat what the sections below explain.
const steps = [
  { key: "install", who: "you", label: "Install", cap: "sha256 ✓", note: "You: one command. CraftPanel verifies the release against its SHA-256 before anything is installed." },
  { key: "java", who: "CraftPanel", label: "Java", cap: "Java 21", note: "CraftPanel: downloads the Java your Minecraft version needs, per server. Nothing to install yourself." },
  { key: "pick", who: "you", label: "Pick", cap: "Paper 1.21.4", note: "You: choose the software, the version and the memory. Paper, Purpur, Fabric, NeoForge, Vanilla or Velocity." },
  { key: "create", who: "CraftPanel", label: "Create", cap: ":25565", note: "CraftPanel: gets the server from its official source, checks it and starts it on its own port." },
  { key: "join", who: "players", label: "Join", cap: "4 online", note: "Players: connect straight to your machine. Console and player list update live." },
  { key: "backup", who: "CraftPanel", label: "Backup", cap: "04:00 nightly", note: "CraftPanel: scheduled, verified archives. Restoring saves the current state first." },
  { key: "update", who: "you", label: "Update", cap: "v1.0.1", note: "You: press update. Minecraft keeps running, and a failed update rolls back by itself." },
] as const;
const idle = "Three things are yours: the install command, the software you pick and when you update. CraftPanel does the rest, on your own machine.";
---

<div class="pb" data-band>
  <div class="pb-out pb-out-l">
    <span class="pb-link" aria-hidden="true"></span>
    <Iso boxes={processScenes.browser()} label="A laptop showing the dashboard" class="iso-line" outline pad={2} />
    <span class="pb-cap mono">your browser</span>
  </div>

  <div class="pb-main">
    <ol class="pb-frame dl-marks">
      {
        steps.map((s, i) => (
          <li class="pb-step" data-note={s.note}>
            <button type="button" class="pb-btn">
              <span class="pb-label mono"><span class="pb-n">{String(i + 1).padStart(2, "0")}</span>{s.label}</span>
              <span class="pb-who mono" data-who={s.who}>{s.who}</span>
              <span class="pb-art">
                <Iso boxes={processScenes[s.key]()} label={`${s.label} illustration`} class="iso-line" outline pad={2} />
              </span>
              <span class="pb-cap mono">{s.cap}</span>
            </button>
          </li>
        ))
      }
      <li class="dl-tab mono" aria-hidden="true">runs on your hardware</li>
    </ol>
    <p class="pb-note mono" data-pb-note>{idle}</p>
  </div>

  <div class="pb-out pb-out-r">
    <span class="pb-link" aria-hidden="true"></span>
    <Iso boxes={processScenes.players()} label="Two players" class="iso-line" outline pad={2} />
    <span class="pb-cap mono">your players</span>
  </div>
</div>
