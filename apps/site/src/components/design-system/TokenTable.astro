---
import css from "../../../../../packages/ui/src/styles/tokens.css?raw";

interface Props {
  group: "surfaces" | "roles";
}
const { group } = Astro.props;
const declarations = (block: string) => Object.fromEntries(
  [...block.matchAll(/(--cp-[\w-]+):\s*([^;]+);/g)].map((m) => [m[1], m[2].trim()]),
);
const light = declarations(css.match(/:root\s*\{([\s\S]*?)\n\}/)![1]);
const dark = { ...light, ...declarations(css.match(/\[data-theme="dark"\]\s*\{([\s\S]*?)\n\}/)![1]) };
const resolve = (name: string, theme: Record<string, string>): string => {
  const value = theme[name];
  if (!value) throw new Error(`Unknown design token: ${name}`);
  return value.replace(/var\((--cp-[\w-]+)\)/g, (_, token) => resolve(token, theme));
};
const groups = {
  surfaces: [
    ["bg", "Page canvas"],
    ["bg-subtle", "Secondary page area"],
    ["surface", "Panels, inputs and dialogs"],
    ["surface-muted", "Quiet fills, hover and selection"],
    ["border", "Dividers and panel edges"],
    ["border-strong", "Stronger boundaries"],
    ["fg", "Primary text"],
    ["fg-muted", "Descriptions and secondary labels"],
    ["console", "Console background"],
    ["console-fg", "Console text"],
    ["console-muted", "Console timestamps, system lines, hints"],
  ],
  roles: [
    ["brand", "Brand mark and brand moments"],
    ["brand-text", "Readable brand text"],
    ["brand-button", "Brand button background"],
    ["brand-button-fg", "Brand button text"],
    ["accent", "Neutral focus and interaction"],
    ["accent-fg", "Text on the neutral accent"],
    ["success", "Success text and tinted states"],
    ["warning", "Attention text and tinted states"],
    ["danger", "Error text and tinted states"],
    ["neutral", "Neutral status text"],
    ["status-running", "Running dot or bar"],
    ["status-starting", "Starting or stopping dot"],
    ["status-crashed", "Crashed or error dot"],
    ["status-stopped", "Stopped or disconnected dot"],
  ],
};
---

<div class="ds-token-table" role="region" aria-label={`${group === "surfaces" ? "Surface" : "Semantic colour"} token values`} tabindex="0">
  <table>
    <thead><tr><th scope="col">Token / purpose</th><th scope="col">Light</th><th scope="col">Dark</th></tr></thead>
    <tbody>
      {groups[group].map(([token, purpose]) => (
        <tr>
          <th scope="row"><code>--cp-{token}</code><small>{purpose}</small></th>
          {[light, dark].map((theme, index) => (
            <td data-theme-label={index === 0 ? "Light" : "Dark"}><span class="ds-token-value"><span class="ds-token-swatch" style={{ background: resolve(`--cp-${token}`, theme) }} aria-hidden="true"></span><code>{resolve(`--cp-${token}`, theme)}</code></span></td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .ds-token-table { overflow-x: auto; border: 1px solid var(--cp-border); border-radius: var(--cp-radius-lg); }
  .ds-token-table:focus-visible { outline: 2px solid var(--cp-accent); outline-offset: 3px; }
  .ds-token-table table { width: 100%; margin: 0; font-size: 0.8125rem; }
  .ds-token-table :is(th, td) { padding: 0.75rem; vertical-align: middle; }
  .ds-token-table th { font-weight: 500; text-align: left; }
  .ds-token-table small { display: block; margin-top: 0.25rem; color: var(--cp-fg-muted); font-weight: 400; }
  .ds-token-table code { padding: 0; background: none; font-size: 0.75rem; white-space: nowrap; }
  .ds-token-value { display: inline-flex; align-items: center; gap: 0.5rem; }
  .ds-token-swatch { display: inline-block; width: 1.5rem; height: 1.5rem; flex: none; border: 1px solid var(--cp-border-strong); border-radius: var(--cp-radius-sm); }
  @media (max-width: 40rem) {
    .ds-token-table table, .ds-token-table tbody { display: block; }
    .ds-token-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .ds-token-table tbody tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-bottom: 1px solid var(--cp-border); }
    .ds-token-table tbody tr:last-child { border-bottom: 0; }
    .ds-token-table tbody th { grid-column: 1 / -1; padding-bottom: 0; }
    .ds-token-table tbody :is(th, td) { border-bottom: 0; }
    .ds-token-table td::before { content: attr(data-theme-label); display: block; margin-bottom: 0.375rem; color: var(--cp-fg-muted); font-size: 0.75rem; }
  }
</style>
