---
// The CraftPanel wordmark: "Craft" in the heavier weight, "Panel" in the regular one and a Signal green underscore, the
// cursor of the console prompt in the mark. Size follows the font size of the parent. The cursor blinks three times
// when the page opens and keeps blinking while the name is hovered; it stands still for reduced motion.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={["cp-wordmark", className]} role="img" aria-label="CraftPanel"
  ><span aria-hidden="true" class="cp-wordmark-a">Craft</span><span aria-hidden="true" class="cp-wordmark-b">Panel</span><span aria-hidden="true" class="cp-cursor"></span></span
>

<style is:global>
  .cp-wordmark {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    font-family: var(--cp-font-display);
    letter-spacing: var(--cp-tracking-heading);
    line-height: 1;
  }
  .cp-wordmark-a {
    font-weight: 600;
  }
  .cp-wordmark-b {
    font-weight: 400;
  }
  .cp-cursor {
    display: inline-block;
    width: 0.52em;
    height: 0.12em;
    margin-left: 0.07em;
    background: var(--cp-brand);
    transform: translateY(0.1em);
    animation: cp-caret 1.1s steps(1, end) 3;
  }
  a:hover .cp-cursor,
  .cp-wordmark:hover .cp-cursor {
    animation: cp-caret 1.1s steps(1, end) infinite;
  }
  @keyframes cp-caret {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cp-cursor,
    a:hover .cp-cursor,
    .cp-wordmark:hover .cp-cursor {
      animation: none;
    }
  }
</style>
