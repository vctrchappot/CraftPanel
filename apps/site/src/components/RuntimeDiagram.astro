---
import Iso from "./Iso.astro";
import Pixel from "./Pixel.astro";
import { runtimeScene } from "../lib/scenes";
---

<figure class="runtime-figure" data-runtime-figure>
  <div class="runtime-top mono"><span>01 / YOUR MACHINE</span><span>ILLUSTRATED</span></div>
  <div class="runtime-stage">
    <div class="runtime-control">
      <div class="runtime-control-bar mono"><Pixel name="terminal" size={14} /><span>craftpanel / dashboard</span></div>
      <div class="runtime-control-body">
        <span class="runtime-control-status mono" data-runtime-status>Connected</span>
        <div class="runtime-window-skeleton" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <span class="runtime-control-note mono" data-runtime-note>Controls, console, settings.</span>
      </div>
    </div>
    <div class="runtime-link mono" aria-hidden="true"><span></span><b>LOCAL IPC</b><span></span></div>
    <div class="runtime-world">
      <Iso boxes={runtimeScene()} label="Three block-world shelters on a shared server chassis, with its power light still on" class="iso runtime-iso" pad={10} />
    </div>
  </div>
  <div class="runtime-telemetry mono">
    <span><i class="dot-run"></i> Minecraft runtime</span>
    <span>20.0 TPS</span>
    <svg viewBox="0 0 180 24" aria-hidden="true"><path d="M0 17H16V15H29V16H46V12H61V14H79V13H96V15H113V12H130V13H147V11H165V12H180" /></svg>
    <span class="runtime-keeps-running">Still running.</span>
  </div>
  <figcaption class="runtime-caption">
    <span data-runtime-caption>Restart the dashboard. Watch what keeps running.</span>
    <button type="button" class="btn btn-small" data-runtime-restart>Restart dashboard <span aria-hidden="true">↻</span></button>
  </figcaption>
</figure>

<style>
  .runtime-figure { margin: 0; min-width: 0; align-self: stretch; border-left: 1px solid var(--line); background: var(--bg); display: flex; flex-direction: column; }
  .runtime-top { display: flex; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line); padding: 12px 18px; color: var(--muted); font-size: 10px; letter-spacing: .08em; }
  .runtime-stage { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 38px minmax(0, 1.4fr); align-items: center; flex: 1; min-height: 290px; padding: 24px 18px; overflow: hidden; }
  .runtime-stage::before { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 24px 24px; opacity: .23; mask-image: linear-gradient(transparent, #000 60%, transparent); }
  .runtime-control { position: relative; z-index: 1; border: 1px solid var(--line-strong); background: var(--surface); transform: translateY(-18px); }
  .runtime-control-bar { display: flex; align-items: center; gap: 6px; padding: 9px 10px; border-bottom: 1px solid var(--line); font-size: 9px; white-space: nowrap; --px-a: var(--fg); }
  .runtime-control-body { padding: 14px 12px; }
  .runtime-control-status { display: flex; align-items: center; gap: 6px; color: var(--run); font-size: 11px; }
  .runtime-control-status::before { content: ""; height: 6px; width: 6px; background: var(--signal); }
  .runtime-window-skeleton { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin: 18px 0; transition: opacity .2s; }
  .runtime-window-skeleton i { height: 23px; border: 1px solid var(--line); background: var(--surface-2); }
  .runtime-window-skeleton i:first-child { grid-column: span 2; height: 4px; background: var(--line-strong); width: 65%; }
  .runtime-window-skeleton i:last-child { grid-column: span 2; height: 4px; background: var(--line); }
  .runtime-control-note { display: block; font-size: 9px; color: var(--muted); line-height: 1.6; min-height: 29px; }
  .runtime-link { position: relative; display: grid; gap: 6px; transform: translateY(3px); }
  .runtime-link span { display: block; height: 1px; background: var(--signal); }
  .runtime-link b { font-size: 7px; text-align: center; font-weight: 400; color: var(--muted); letter-spacing: .03em; }
  .runtime-world { position: relative; z-index: 1; min-width: 0; padding-top: 8px; }
  .runtime-telemetry { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; padding: 14px 18px; border-top: 1px solid var(--line); color: var(--muted); font-size: 10px; }
  .runtime-telemetry > span:first-child { display: flex; align-items: center; gap: 7px; color: var(--fg); }
  .runtime-telemetry svg { flex: 1; min-width: 60px; max-width: 130px; height: 22px; overflow: visible; }
  .runtime-telemetry path { stroke: var(--signal); stroke-width: 1.5; fill: none; }
  .runtime-keeps-running { color: var(--run); }
  .runtime-caption { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 18px; border-top: 1px solid var(--line); background: var(--surface); }
  .runtime-caption > span { max-width: 28ch; font-size: 12px; color: var(--muted); }
  .runtime-caption button { flex: none; font-size: 11px; }
  .is-restarting .runtime-control-status { color: var(--amber-text); }
  .is-restarting .runtime-control-status::before { background: var(--amber); }
  .is-restarting .runtime-window-skeleton { opacity: .2; }
  .is-restarting .runtime-link span { background: var(--amber); }
  @media (max-width: 980px) {
    .runtime-figure { border-left: 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 1100px) and (min-width: 981px), (max-width: 480px) {
    .runtime-stage { grid-template-columns: minmax(0, 1fr) 24px minmax(0, 1.2fr); padding: 20px 12px; min-height: 230px; }
    .runtime-control-bar { font-size: 8px; gap: 4px; padding: 8px 6px; }
    .runtime-control-bar :global(svg) { display: none; }
    .runtime-control-body { padding: 12px 8px; }
    .runtime-caption { flex-wrap: wrap; }
    .runtime-caption > span { max-width: none; }
    .runtime-telemetry { gap: 10px 14px; }
    .runtime-telemetry svg { display: none; }
  }
</style>
