---
import Iso from "./Iso.astro";
import Pixel from "./Pixel.astro";
import { runtimeScene } from "../lib/scenes";
---

<figure class="runtime-figure" data-update>
  <div class="runtime-top mono"><span>Your host</span><span>Interactive example</span></div>
  <div class="runtime-stage">
    <div class="runtime-control">
      <div class="runtime-control-bar mono"><Pixel name="terminal" size={14} /><span>Dashboard</span></div>
      <div class="runtime-control-body">
        <span class="runtime-control-status mono" data-panel-status>Connected</span>
        <div class="runtime-window-skeleton" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <span class="runtime-control-note mono" data-panel-version>v1.0.0</span>
      </div>
    </div>
    <div class="runtime-link" aria-hidden="true"><span></span><span></span></div>
    <div class="runtime-world">
      <Iso boxes={runtimeScene()} label="Three block-world shelters on a shared server chassis, with its power light still on" class="iso runtime-iso" pad={10} />
    </div>
  </div>
  <div class="runtime-telemetry mono">
    <span><i class="dot-run"></i> Minecraft · 6 online</span>
    <span>20.0 TPS</span>
    <svg viewBox="0 0 180 24" aria-hidden="true"><path d="M0 17H16V15H29V16H46V12H61V14H79V13H96V15H113V12H130V13H147V11H165V12H180" /></svg>
    <span class="runtime-keeps-running">Still running.</span>
  </div>
  <figcaption class="demo-update">
    <ol class="du-steps mono" aria-label="Example dashboard update steps">
      <li data-step="0"><span>Download v1.0.1</span><i class="du-state" aria-hidden="true"></i></li>
      <li data-step="1"><span>Verify SHA-256</span><i class="du-state" aria-hidden="true"></i></li>
      <li data-step="2"><span>Snapshot database</span><i class="du-state" aria-hidden="true"></i></li>
      <li data-step="3"><span>Start dashboard</span><i class="du-state" aria-hidden="true"></i></li>
      <li data-step="4" class="du-rollback"><span>Restore v1.0.0 + database</span><i class="du-state" aria-hidden="true"></i></li>
    </ol>
    <p class="du-result" data-result role="status">Try an update. The Minecraft process keeps running.</p>
    <div class="du-actions">
      <button type="button" class="btn btn-small" data-run="ok">Run panel update</button>
      <button type="button" class="btn btn-small btn-quiet" data-run="fail">Try a failed update</button>
    </div>
  </figcaption>
</figure>

<style>
  .runtime-figure { margin: 0; min-width: 0; border: 1px solid var(--line); background: var(--bg); display: flex; flex-direction: column; }
  .runtime-top { display: flex; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line); padding: 10px 14px; color: var(--muted); font-size: 11px; }
  .runtime-stage { position: relative; display: grid; grid-template-columns: minmax(0, .85fr) 22px minmax(0, 1.15fr); align-items: center; min-height: 200px; padding: 20px 14px; overflow: hidden; }
  .runtime-stage::before { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 24px 24px; opacity: .23; mask-image: linear-gradient(transparent, #000 60%, transparent); }
  .runtime-control { position: relative; z-index: 1; border: 1px solid var(--line-strong); background: var(--surface); }
  .runtime-control-bar { display: flex; align-items: center; gap: 6px; padding: 9px 10px; border-bottom: 1px solid var(--line); font-size: 12px; white-space: nowrap; --px-a: var(--fg); }
  .runtime-control-body { padding: 14px 12px; }
  .runtime-control-status { display: flex; align-items: center; gap: 6px; color: var(--run); font-size: 12px; }
  .runtime-control-status::before { content: ""; height: 6px; width: 6px; background: var(--signal); }
  .runtime-window-skeleton { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin: 14px 0; transition: opacity .18s ease-out; }
  .runtime-window-skeleton i { height: 18px; border: 1px solid var(--line); background: var(--surface-2); }
  .runtime-window-skeleton i:first-child { grid-column: span 2; height: 4px; background: var(--line-strong); width: 65%; }
  .runtime-window-skeleton i:last-child { grid-column: span 2; height: 4px; background: var(--line); }
  .runtime-control-note { display: block; font-size: 12px; color: var(--muted); line-height: 1.6; }
  .runtime-link { position: relative; display: grid; gap: 10px; }
  .runtime-link span { display: block; height: 1px; background: var(--signal); }
  .runtime-world { position: relative; z-index: 1; min-width: 0; padding-top: 8px; }
  .runtime-telemetry { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; padding: 12px 14px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  .runtime-telemetry > span:first-child { display: flex; align-items: center; gap: 7px; color: var(--fg); }
  .runtime-telemetry svg { flex: 1; min-width: 40px; max-width: 90px; height: 20px; overflow: visible; }
  .runtime-telemetry path { stroke: var(--signal); stroke-width: 1.5; fill: none; }
  .runtime-keeps-running { color: var(--run); }
  .demo-update { display: grid; gap: 14px; margin: 0; padding: 14px; border-top: 1px solid var(--line); background: var(--surface); }
  .du-steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); font-size: 12px; }
  .du-steps li { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 9px 10px; color: var(--muted); }
  .du-steps li:nth-child(even) { border-left: 1px solid var(--line); }
  .du-steps li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  .du-steps li[data-state="run"], .du-steps li[data-state="ok"], .du-steps li[data-state="fail"] { color: var(--fg); }
  .du-state { width: 8px; height: 8px; flex: none; border: 1px solid var(--line-strong); }
  [data-state="run"] .du-state { background: var(--amber); border-color: var(--amber); }
  [data-state="ok"] .du-state { background: var(--signal); border-color: var(--signal); }
  [data-state="fail"] .du-state { background: var(--ember); border-color: var(--ember); }
  [data-state="fail"] span { color: var(--ember-text); }
  .du-steps .du-rollback { display: none; grid-column: span 2; background: color-mix(in srgb, var(--ember) 6%, transparent); }
  .is-fail .du-steps .du-rollback { display: flex; }
  .du-result { min-height: 3.1em; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
  .du-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .du-actions :global(.btn) { min-height: 36px; padding: 0 12px; font-size: 13px; font-weight: 500; }
  [data-panel-state="updating"] .runtime-control-status { color: var(--amber-text); }
  [data-panel-state="updating"] .runtime-control-status::before { background: var(--amber); }
  [data-panel-state="updating"] .runtime-window-skeleton { opacity: .2; }
  [data-panel-state="updating"] .runtime-link span { background: var(--amber); }
  [data-panel-state="failed"] .runtime-control-status { color: var(--ember-text); }
  [data-panel-state="failed"] .runtime-control-status::before { background: var(--ember); }
  @media (max-width: 1100px) and (min-width: 981px), (max-width: 480px) {
    .runtime-stage { grid-template-columns: minmax(0, 1fr) 16px minmax(0, 1fr); padding: 16px 10px; }
    .runtime-control-bar { padding: 9px 8px; }
    .runtime-control-body { padding: 12px 8px; }
    .runtime-telemetry svg { display: none; }
    .du-steps { font-size: 11px; }
    .du-steps li { padding: 9px 7px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .runtime-window-skeleton { transition: none; }
  }
</style>
