---
// A dashboard screenshot in its dark and light variant; CSS shows the one matching the page theme.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: "overview" | "console" | "plugins" | "servers" | "new-server";
  alt: string;
  eager?: boolean;
}
const { name, alt, eager = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png", { eager: true });
const pick = (scheme: string) => images[`../assets/screenshots/${name}-${scheme}.png`].default;
const widths = [720, 1200, 1600, 2400];
const sizes = "(min-width: 1280px) 900px, 100vw";
---

<Image class="shot-img if-dark" src={pick("dark")} alt={alt} widths={widths} sizes={sizes} format="webp" quality={82} loading={eager ? "eager" : "lazy"} />
<Image class="shot-img if-light" src={pick("light")} alt={alt} widths={widths} sizes={sizes} format="webp" quality={82} loading="lazy" />
