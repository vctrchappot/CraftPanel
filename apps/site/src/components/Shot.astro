---
// A dashboard screenshot in a browser frame, in the dark and light variant (CSS shows the one matching the theme).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: "overview" | "console" | "plugins" | "servers" | "new-server";
  alt: string;
  priority?: boolean;
}
const { name, alt, priority = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png", { eager: true });
const pick = (scheme: string) => images[`../assets/screenshots/${name}-${scheme}.png`].default;
const loading = priority ? "eager" : "lazy";
const widths = [720, 1200, 1600, 2400];
const sizes = "(min-width: 1200px) 1120px, 100vw";
---

<figure class="shot">
  <div class="shot-bar" aria-hidden="true"><span></span><span></span><span></span><div class="shot-url">localhost:8080</div></div>
  <Image class="shot-img if-dark" src={pick("dark")} alt={alt} widths={widths} sizes={sizes} format="webp" quality={82} loading={loading} fetchpriority={priority ? "high" : undefined} />
  <Image class="shot-img if-light" src={pick("light")} alt={alt} widths={widths} sizes={sizes} format="webp" quality={82} loading="lazy" />
</figure>
