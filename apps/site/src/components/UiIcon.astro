---
// One-colour UI icons on a 24x24 grid of 2-unit pixels, so they stay sharp at 12, 24, 36 and 48 px.
// Paths and their licence: src/lib/ui-icons.ts. Colour: --px-a, default currentColor.
import { uiIcons, type UiIconName } from "../lib/ui-icons";

interface Props {
  name: UiIconName;
  size?: 12 | 24 | 36 | 48;
  class?: string;
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;
---

<svg
  class:list={["px-icon", "ui-icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  shape-rendering="crispEdges"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
>
  <path d={uiIcons[name]} class="px-a"></path>
</svg>
